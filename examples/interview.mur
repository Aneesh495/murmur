; First run make demo to generate the synthetic source.
(murmur
  (version 1) (rate 24000) (channels 2) (seed 7)
  (source field (path "../build/demo/field.wav"))
  (redact field (from 2.75) (to 3.4) (guard 0.02) (mode mute))
  (clip opening (source field) (from 0.2) (to 4) (at 0)
        (fade-in 0.03) (fade-out 0.1))
  (clip closing (source field) (from 4) (to 8) (at 3.7)
        (fade-in 0.1) (fade-out 0.06))
  (effect highpass (hz 80))
  (effect compress (threshold-db -24) (ratio 2))
  (effect limit (ceiling-db -2))
  (marker (at 0) (label "Start"))
  (marker (at 2.55) (label "Removed source interval")))
