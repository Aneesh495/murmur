;;; Normalized RBJ biquads, transposed direct form II. State is per channel and
;;; survives block boundaries. Filter design refuses unstable denominators.
(define-module (murmur dsp biquad)
  #:use-module (murmur error)
  #:use-module (murmur clock)
  #:use-module (murmur buffer)
  #:export (biquad-coefficients biquad-response make-biquad))
(define pi 3.141592653589793)
(define* (biquad-coefficients kind rate hz #:key (q 0.7071067811865476) (gain-db 0))
  (ensure (and (valid-rate? rate) (finite-real? hz) (< 0 hz (/ rate 2))
               (finite-real? q) (<= 0.1 q 20) (finite-real? gain-db) (<= -36 gain-db 36))
          'filter "invalid filter frequency, resonance, or gain")
  (let* ((w (* 2 pi (/ hz rate))) (cs (cos w)) (sn (sin w))
         (alpha (/ sn (* 2 q))) (a (expt 10.0 (/ gain-db 40.0)))
         (beta (* 2 (sqrt a) alpha))
         (raw
          (case kind
            ((lowpass) (list (/ (- 1 cs) 2) (- 1 cs) (/ (- 1 cs) 2)
                             (+ 1 alpha) (* -2 cs) (- 1 alpha)))
            ((highpass) (list (/ (+ 1 cs) 2) (- (+ 1 cs)) (/ (+ 1 cs) 2)
                              (+ 1 alpha) (* -2 cs) (- 1 alpha)))
            ((notch) (list 1 (* -2 cs) 1 (+ 1 alpha) (* -2 cs) (- 1 alpha)))
            ((peak) (list (+ 1 (* alpha a)) (* -2 cs) (- 1 (* alpha a))
                          (+ 1 (/ alpha a)) (* -2 cs) (- 1 (/ alpha a))))
            ((low-shelf)
             (list (* a (+ (+ a 1) (- (* (- a 1) cs)) beta))
                   (* 2 a (- (- a 1) (* (+ a 1) cs)))
                   (* a (- (- (+ a 1) (* (- a 1) cs)) beta))
                   (+ (+ a 1) (* (- a 1) cs) beta)
                   (* -2 (+ (- a 1) (* (+ a 1) cs)))
                   (- (+ (+ a 1) (* (- a 1) cs)) beta)))
            ((high-shelf)
             (list (* a (+ (+ a 1) (* (- a 1) cs) beta))
                   (* -2 a (+ (- a 1) (* (+ a 1) cs)))
                   (* a (- (+ (+ a 1) (* (- a 1) cs)) beta))
                   (+ (- (+ a 1) (* (- a 1) cs)) beta)
                   (* 2 (- (- a 1) (* (+ a 1) cs)))
                   (- (- (+ a 1) (* (- a 1) cs)) beta)))
            (else (fail 'filter "unknown biquad type" kind))))
         (a0 (list-ref raw 3))
         (c (list->vector (map (lambda (x) (/ x a0))
                              (list (list-ref raw 0) (list-ref raw 1) (list-ref raw 2)
                                    (list-ref raw 4) (list-ref raw 5)))))
         (a1 (vector-ref c 3)) (a2 (vector-ref c 4)))
    (ensure (and (< (abs a2) 1) (> (+ 1 a1 a2) 0) (> (+ 1 (- a1) a2) 0))
            'filter "filter denominator is unstable") c))
(define (biquad-response c omega)
  (let ((z (exp (* 0-1i omega))))
    (/ (+ (vector-ref c 0) (* (vector-ref c 1) z) (* (vector-ref c 2) z z))
       (+ 1 (* (vector-ref c 3) z) (* (vector-ref c 4) z z)))))
(define (make-biquad rate channels coefficients)
  (let ((state (make-vector channels #f)))
    (do ((c 0 (+ c 1))) ((= c channels)) (vector-set! state c (vector 0.0 0.0)))
    (lambda (audio)
      (ensure (and (= rate (audio-rate audio)) (= channels (audio-channels audio)))
              'format "biquad state format changed")
      (let ((b0 (vector-ref coefficients 0)) (b1 (vector-ref coefficients 1))
            (b2 (vector-ref coefficients 2)) (a1 (vector-ref coefficients 3)) (a2 (vector-ref coefficients 4)))
        (do ((c 0 (+ c 1))) ((= c channels))
          (let* ((s (vector-ref state c)) (z1 (vector-ref s 0)) (z2 (vector-ref s 1)))
            (do ((i 0 (+ i 1))) ((= i (audio-frames audio)))
              (let* ((x (audio-ref audio c i)) (y (+ (* b0 x) z1)))
                (set! z1 (+ (* b1 x) (- (* a1 y)) z2))
                (set! z2 (- (* b2 x) (* a2 y)))
                (audio-set! audio c i y)))
            (vector-set! s 0 z1) (vector-set! s 1 z2)))) audio)))
