;;; Iterative radix-2 FFT over split real/imaginary vectors. Plans reuse bit
;;; reversal and twiddle tables across STFT windows. Forward is unnormalized;
;;; inverse divides by N, so Parseval has its usual 1/N factor.
(define-module (murmur dsp fft)
  #:use-module (murmur error)
  #:use-module (srfi srfi-4)
  #:use-module (srfi srfi-9)
  #:export (power-of-two? next-power-of-two make-fft-plan fft-size fft-execute! fft-real))
(define (power-of-two? n)
  (and (exact-integer? n) (> n 0) (= 0 (logand n (- n 1)))))
(define (next-power-of-two n)
  (ensure (and (exact-integer? n) (> n 0) (<= n 65536)) 'fft "FFT dimension outside budget")
  (let loop ((p 1)) (if (>= p n) p (loop (* p 2)))))
(define-record-type <fft-plan>
  (%fft n reverse real imag) fft-plan?
  (n fft-size) (reverse fft-reverse) (real fft-real-twiddle) (imag fft-imag-twiddle))
(define (make-fft-plan n)
  (ensure (and (power-of-two? n) (<= 2 n 65536)) 'fft "FFT size must be a power of two from 2 to 65536")
  (let* ((levels (integer-length (- n 1))) (reverse (make-u32vector n 0))
         (real (make-f64vector (quotient n 2) 0.0)) (imag (make-f64vector (quotient n 2) 0.0)))
    (do ((i 0 (+ i 1))) ((= i n))
      (let loop ((x i) (bits levels) (value 0))
        (if (zero? bits) (u32vector-set! reverse i value)
            (loop (ash x -1) (- bits 1) (+ (* value 2) (logand x 1))))))
    (do ((i 0 (+ i 1))) ((= i (quotient n 2)))
      (let ((angle (* -6.283185307179586 (/ i n))))
        (f64vector-set! real i (cos angle)) (f64vector-set! imag i (sin angle))))
    (%fft n reverse real imag)))
(define* (fft-execute! plan real imag #:key (inverse? #f))
  (let ((n (fft-size plan)))
    (ensure (and (= n (f64vector-length real)) (= n (f64vector-length imag)))
            'fft "FFT vectors do not match the plan")
    (do ((i 0 (+ i 1))) ((= i n))
      (let ((j (u32vector-ref (fft-reverse plan) i)))
        (when (< i j)
          (let ((r (f64vector-ref real i)) (v (f64vector-ref imag i)))
            (f64vector-set! real i (f64vector-ref real j)) (f64vector-set! real j r)
            (f64vector-set! imag i (f64vector-ref imag j)) (f64vector-set! imag j v)))))
    (let stage ((size 2))
      (when (<= size n)
        (let ((half (quotient size 2)) (step (quotient n size)))
          (do ((base 0 (+ base size))) ((= base n))
            (do ((j 0 (+ j 1))) ((= j half))
              (let* ((a (+ base j)) (b (+ a half)) (k (* j step))
                     (wr (f64vector-ref (fft-real-twiddle plan) k))
                     (wi (* (if inverse? -1.0 1.0) (f64vector-ref (fft-imag-twiddle plan) k)))
                     (tr (- (* wr (f64vector-ref real b)) (* wi (f64vector-ref imag b))))
                     (ti (+ (* wr (f64vector-ref imag b)) (* wi (f64vector-ref real b))))
                     (ar (f64vector-ref real a)) (ai (f64vector-ref imag a)))
                (f64vector-set! real a (+ ar tr)) (f64vector-set! imag a (+ ai ti))
                (f64vector-set! real b (- ar tr)) (f64vector-set! imag b (- ai ti))))))
        (stage (* size 2))))
    (when inverse?
      (do ((i 0 (+ i 1))) ((= i n))
        (f64vector-set! real i (/ (f64vector-ref real i) n))
        (f64vector-set! imag i (/ (f64vector-ref imag i) n))))
    (values real imag)))
(define (fft-real input)
  (let* ((n (f64vector-length input)) (real (make-f64vector n 0.0))
         (imag (make-f64vector n 0.0)))
    (do ((i 0 (+ i 1))) ((= i n)) (f64vector-set! real i (f64vector-ref input i)))
    (fft-execute! (make-fft-plan n) real imag)))
