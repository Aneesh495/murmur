;;; Conservative, opt-in recording repair. A frozen noise profile avoids learning
;;; speech as noise. Isolated-click repair is deliberately narrower than de-clip.
(define-module (murmur dsp repair)
  #:use-module (murmur error)
  #:use-module (murmur buffer)
  #:use-module (murmur dsp stft)
  #:use-module (murmur dsp envelope)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-4)
  #:export (spectral-denoise repair-clicks))
(define* (spectral-denoise audio profile-from profile-to
                           #:key (size 512) (strength 1.2) (floor-db -18) (smoothing 0.6))
  (ensure (and (finite-real? strength) (<= 0 strength 4)
               (finite-real? floor-db) (<= -60 floor-db 0)
               (finite-real? smoothing) (<= 0 smoothing 0.99)) 'repair "invalid denoise setting")
  (let* ((hop (quotient size 4))
         (profile (spectral-profile audio profile-from profile-to size hop))
         (minimum (db->gain floor-db))
         (history (list->vector (map (lambda (_) (make-f64vector (+ 1 (quotient size 2)) 1.0))
                                     (iota (audio-channels audio))))))
    (stft-process audio size hop
      (lambda (channel start real imag)
        (let ((noise (vector-ref profile channel)) (previous (vector-ref history channel)))
          (do ((k 0 (+ k 1))) ((> k (quotient size 2)))
            (let* ((power (+ (expt (f64vector-ref real k) 2) (expt (f64vector-ref imag k) 2)))
                   (target (sqrt (max (* minimum minimum)
                                       (- 1.0 (/ (* strength (f64vector-ref noise k)) (+ power 1e-30))))))
                   (gain (+ (* smoothing (f64vector-ref previous k)) (* (- 1 smoothing) target))))
              (f64vector-set! previous k gain)
              (f64vector-set! real k (* gain (f64vector-ref real k)))
              (f64vector-set! imag k (* gain (f64vector-ref imag k)))
              ;; Mirror exactly to retain conjugate symmetry and a real output.
              (unless (or (= k 0) (= k (quotient size 2)))
                (let ((mirror (- size k)))
                  (f64vector-set! real mirror (* gain (f64vector-ref real mirror)))
                  (f64vector-set! imag mirror (* gain (f64vector-ref imag mirror))))))))))))
(define (median values)
  (let* ((sorted (sort values <)) (n (length sorted)))
    (if (odd? n) (list-ref sorted (quotient n 2))
        (/ (+ (list-ref sorted (- (quotient n 2) 1)) (list-ref sorted (quotient n 2))) 2))))
(define* (repair-clicks audio #:key (threshold 0.15) (sensitivity 8) (radius 3))
  (ensure (and (finite-real? threshold) (<= 0.001 threshold 1)
               (finite-real? sensitivity) (<= 2 sensitivity 50)
               (exact-integer-in? radius 2 16)) 'repair "invalid click-repair setting")
  (ensure (<= (* 2 (audio-bytes audio)) (max-buffer-bytes)) 'budget "click repair exceeds aggregate buffer budget")
  (let ((out (audio-copy audio)))
    (do ((c 0 (+ c 1))) ((= c (audio-channels audio)))
      (do ((i radius (+ i 1))) ((>= i (- (audio-frames audio) radius)))
        (let* ((neighbors (append (map (lambda (j) (audio-ref audio c (- i j))) (iota radius 1))
                                  (map (lambda (j) (audio-ref audio c (+ i j))) (iota radius 1))))
               (center (median neighbors))
               (deviation (median (map (lambda (x) (abs (- x center))) neighbors)))
               (difference (abs (- (audio-ref audio c i) center))))
          (when (> difference (max threshold (* sensitivity deviation)))
            (audio-set! out c i (/ (+ (audio-ref audio c (- i 1)) (audio-ref audio c (+ i 1))) 2)))))) out))
