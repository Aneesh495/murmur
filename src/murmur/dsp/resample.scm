;;; Windowed-sinc resampling with exact rational sample positions. Common rate
;;; pairs use every rational phase. Unusual coprime rates interpolate a bounded
;;; phase table. A caller supplies already sanitized samples and edge policy.
(define-module (murmur dsp resample)
  #:use-module (murmur error)
  #:use-module (murmur clock)
  #:use-module (murmur buffer)
  #:use-module (srfi srfi-4)
  #:use-module (srfi srfi-9)
  #:export (make-resampler resampler-ref resample-audio resampler-bytes))
(define pi 3.141592653589793)
(define-record-type <resampler>
  (%resampler from to radius phases exact-phase table) resampler?
  (from resampler-from) (to resampler-to) (radius resampler-radius)
  (phases resampler-phases) (exact-phase resampler-exact?) (table resampler-table))
(define (sinc x) (if (< (abs x) 1e-12) 1.0 (/ (sin (* pi x)) (* pi x))))
(define (kernel radius cutoff phase)
  (let* ((size (+ (* 2 radius) 1)) (weights (make-f64vector size 0.0)) (sum 0.0))
    (do ((j 0 (+ j 1))) ((= j size))
      (let* ((d (- (- j radius) phase)) (w (/ d (+ radius 1)))
             (window (+ 0.42 (* 0.5 (cos (* pi w))) (* 0.08 (cos (* 2 pi w)))))
             (v (* cutoff (sinc (* cutoff d)) window)))
        (f64vector-set! weights j v) (set! sum (+ sum v))))
    (do ((j 0 (+ j 1))) ((= j size))
      (f64vector-set! weights j (/ (f64vector-ref weights j) sum))) weights))
(define (make-resampler from to)
  (ensure (and (valid-rate? from) (valid-rate? to)) 'rate "invalid resampling rates")
  (if (= from to) (%resampler from to 0 1 #t #())
      (let* ((cutoff (* 0.94 (min 1.0 (/ to from))))
             (radius (inexact->exact (ceiling (/ 16 cutoff))))
             (rational-phases (quotient to (gcd from to)))
             (exact-phase (<= rational-phases 2048))
             (phases (if exact-phase rational-phases 256))
             (table (make-vector (+ phases 1))))
        (ensure (<= (* 8 (+ phases 1) (+ 1 (* 2 radius))) (* 32 1024 1024))
                'budget "resampling kernel exceeds memory budget")
        (do ((p 0 (+ p 1))) ((> p phases))
          (vector-set! table p (kernel radius cutoff (/ p phases))))
        (%resampler from to radius phases exact-phase table))))
(define (resampler-bytes r)
  (if (= (resampler-from r) (resampler-to r)) 0
      (* 8 (+ 1 (resampler-phases r)) (+ 1 (* 2 (resampler-radius r))))))
(define (resampler-ref r sample output-frame)
  (ensure (and (exact-integer? output-frame) (>= output-frame 0)) 'bounds "invalid output sample index")
  (if (= (resampler-from r) (resampler-to r)) (sample output-frame)
      (let* ((position (* output-frame (resampler-from r)))
             (base (quotient position (resampler-to r)))
             (remainder (modulo position (resampler-to r)))
             (phase (/ (* remainder (resampler-phases r)) (resampler-to r)))
             (index (floor phase)) (alpha (exact->inexact (- phase index)))
             (a (vector-ref (resampler-table r) index))
             (b (vector-ref (resampler-table r) (+ index 1)))
             (radius (resampler-radius r)) (size (+ 1 (* 2 radius))))
        (let loop ((j 0) (sum 0.0))
          (if (= j size) sum
              (let ((weight (if (zero? alpha) (f64vector-ref a j)
                                (+ (* (- 1.0 alpha) (f64vector-ref a j))
                                   (* alpha (f64vector-ref b j))))))
                (loop (+ j 1) (+ sum (* weight (sample (+ base (- j radius))))))))))))
(define (resample-audio a to)
  (let* ((r (make-resampler (audio-rate a) to))
         (n (duration-frames (audio-frames a) (audio-rate a) to))
         (out (make-audio to (audio-channels a) n)))
    (unless (zero? (audio-frames a))
      (do ((c 0 (+ c 1))) ((= c (audio-channels a)))
        (let ((sample (lambda (i) (audio-ref a c (max 0 (min (- (audio-frames a) 1) i))))))
          (do ((i 0 (+ i 1))) ((= i n)) (audio-set! out c i (resampler-ref r sample i)))))) out))
