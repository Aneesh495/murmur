;;; Linear edit fades preserve amplitude when two aligned copies crossfade.
;;; Equal-power panning preserves energy when a mono source enters stereo.
(define-module (murmur dsp envelope)
  #:use-module (murmur error)
  #:export (db->gain gain->db fade-weight pan-gains balance-gains))
(define (db->gain db)
  (ensure (finite-real? db) 'gain "decibel value must be finite")
  (expt 10.0 (/ db 20.0)))
(define (gain->db gain)
  (ensure (and (finite-real? gain) (>= gain 0)) 'gain "amplitude must be nonnegative")
  (if (zero? gain) -300.0 (max -300.0 (* 20.0 (/ (log gain) (log 10.0))))))
(define (fade-weight index frames fade-in fade-out)
  (ensure (and (exact-integer? index) (<= 0 index) (< index frames)
               (<= 0 fade-in) (<= 0 fade-out) (<= (+ fade-in fade-out) frames))
          'envelope "invalid fade coordinate")
  (* (if (zero? fade-in) 1.0 (min 1.0 (/ index fade-in)))
     (if (zero? fade-out) 1.0 (min 1.0 (/ (- frames 1 index) fade-out)))))
(define (pan-gains pan)
  (ensure (and (finite-real? pan) (<= -1 pan 1)) 'pan "pan must be between -1 and 1")
  (let ((angle (* (+ pan 1) 0.7853981633974483)))
    (cons (cos angle) (sin angle))))
(define (balance-gains pan)
  (ensure (and (finite-real? pan) (<= -1 pan 1)) 'pan "balance must be between -1 and 1")
  (cons (if (> pan 0) (cos (* pan 1.5707963267948966)) 1.0)
        (if (< pan 0) (cos (* pan 1.5707963267948966)) 1.0)))
