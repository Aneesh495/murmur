;;; Stereo-linked dynamics use one envelope per frame. Every time constant is
;;; sample-clock based, so channel count and I/O blocking cannot change it.
(define-module (murmur dsp dynamics)
  #:use-module (murmur error)
  #:use-module (murmur clock)
  #:use-module (murmur buffer)
  #:use-module (murmur dsp envelope)
  #:export (compressor-curve make-compressor make-gate make-limiter))
(define (time-coefficient rate milliseconds)
  (ensure (and (valid-rate? rate) (finite-real? milliseconds) (<= 0.01 milliseconds 10000))
          'dynamics "time constant outside 0.01 to 10000 milliseconds")
  (exp (/ -1000.0 (* rate milliseconds))))
(define (frame-peak a i)
  (let loop ((c 0) (peak 0.0))
    (if (= c (audio-channels a)) peak (loop (+ c 1) (max peak (abs (audio-ref a c i)))))))
(define (apply-frame-gain! a i gain)
  (do ((c 0 (+ c 1))) ((= c (audio-channels a)))
    (audio-set! a c i (* gain (audio-ref a c i)))))
(define (check-state-format a rate channels)
  (ensure (and (= rate (audio-rate a)) (= channels (audio-channels a)))
          'format "dynamics state format changed"))
(define (compressor-curve level threshold ratio knee)
  (let ((over (- level threshold)) (slope (- (/ 1.0 ratio) 1.0)))
    (cond ((and (> knee 0) (> over (- (/ knee 2))) (< over (/ knee 2)))
           (* slope (/ (expt (+ over (/ knee 2)) 2) (* 2 knee))))
          ((>= over (/ knee 2)) (* slope over)) (else 0.0))))
(define* (make-compressor rate channels #:key (threshold -18) (ratio 3) (knee 6)
                          (attack 10) (release 120) (makeup 0))
  (ensure (and (finite-real? threshold) (<= -96 threshold 0)
               (finite-real? ratio) (<= 1 ratio 100)
               (finite-real? knee) (<= 0 knee 36)
               (finite-real? makeup) (<= -24 makeup 24)) 'dynamics "invalid compressor setting")
  (let ((attack-c (time-coefficient rate attack)) (release-c (time-coefficient rate release))
        (reduction 0.0))
    (lambda (a)
      (check-state-format a rate channels)
      (do ((i 0 (+ i 1))) ((= i (audio-frames a)))
        (let* ((target (compressor-curve (gain->db (frame-peak a i)) threshold ratio knee))
               (c (if (< target reduction) attack-c release-c)))
          (set! reduction (+ (* c reduction) (* (- 1.0 c) target)))
          (apply-frame-gain! a i (db->gain (+ reduction makeup))))) a)))
(define* (make-gate rate channels #:key (threshold -45) (hysteresis 6) (hold 80)
                    (attack 5) (release 120) (range-db -40))
  (ensure (and (finite-real? threshold) (<= -96 threshold 0)
               (finite-real? hysteresis) (<= 0 hysteresis 24)
               (finite-real? hold) (<= 0 hold 10000)
               (finite-real? range-db) (<= -96 range-db 0)) 'dynamics "invalid gate setting")
  (let ((attack-c (time-coefficient rate attack)) (release-c (time-coefficient rate release))
        (open? #f) (remaining 0) (gain (db->gain range-db))
        (closed (db->gain range-db)) (hold-frames (round (* rate (/ hold 1000)))))
    (lambda (a)
      (check-state-format a rate channels)
      (do ((i 0 (+ i 1))) ((= i (audio-frames a)))
        (let ((level (gain->db (frame-peak a i))))
          (cond ((>= level threshold) (set! open? #t) (set! remaining hold-frames))
                ((and open? (< level (- threshold hysteresis)))
                 (if (> remaining 0) (set! remaining (- remaining 1)) (set! open? #f)))))
        (let* ((target (if open? 1.0 closed)) (c (if open? attack-c release-c)))
          (set! gain (+ (* c gain) (* (- 1.0 c) target)))
          (apply-frame-gain! a i gain))) a)))
(define* (make-limiter rate channels #:key (ceiling-db -1) (release 80))
  (ensure (and (finite-real? ceiling-db) (<= -24 ceiling-db 0)) 'dynamics "invalid limiter ceiling")
  (let ((ceiling (db->gain ceiling-db)) (release-c (time-coefficient rate release)) (gain 1.0))
    (lambda (a)
      (check-state-format a rate channels)
      (do ((i 0 (+ i 1))) ((= i (audio-frames a)))
        (let* ((peak (frame-peak a i)) (target (if (> peak ceiling) (/ ceiling peak) 1.0)))
          ;; Instant attack enforces the sample ceiling. Release never rises
          ;; above the current frame's safe gain. This is not a true-peak meter.
          (set! gain (min target (+ (* release-c gain) (- 1.0 release-c))))
          (apply-frame-gain! a i gain))) a)))
