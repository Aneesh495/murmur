;;; Weighted overlap-add with explicit left and right zero extension. Division
;;; by accumulated squared windows reconstructs the first and last samples too.
(define-module (murmur dsp stft)
  #:use-module (murmur error)
  #:use-module (murmur buffer)
  #:use-module (murmur dsp fft)
  #:use-module (srfi srfi-4)
  #:use-module (srfi srfi-1)
  #:export (hann-window stft-process spectral-profile))
(define (hann-window n)
  (let ((w (make-f64vector n 0.0)))
    (do ((i 0 (+ i 1))) ((= i n))
      (f64vector-set! w i (* 0.5 (- 1 (cos (* 6.283185307179586 (/ i n))))))) w))
(define (window-spectrum a c start n window real imag plan)
  (do ((i 0 (+ i 1))) ((= i n))
    (let ((at (+ start i)))
      (f64vector-set! real i (* (f64vector-ref window i)
                                (if (<= 0 at (- (audio-frames a) 1)) (audio-ref a c at) 0.0)))
      (f64vector-set! imag i 0.0)))
  (fft-execute! plan real imag))
(define (check-window n hop)
  (ensure (and (power-of-two? n) (<= 32 n 8192) (exact-integer? hop)
               (<= 1 hop (quotient n 2)) (zero? (modulo n hop)))
          'stft "window must be 32 to 8192 samples with a dividing hop at most N/2"))
(define (stft-process a n hop transform)
  (check-window n hop)
  (let* ((frames (audio-frames a))
         (_ (ensure (<= (+ (* 2 (audio-bytes a)) (* frames 8)) (max-buffer-bytes))
                    'budget "spectral processing exceeds aggregate buffer budget"))
         (out (make-audio (audio-rate a) (audio-channels a) frames))
         (weight (make-f64vector frames 0.0)) (window (hann-window n))
         (plan (make-fft-plan n)) (real (make-f64vector n 0.0)) (imag (make-f64vector n 0.0)))
    (do ((start (- hop n) (+ start hop))) ((>= start frames))
      (do ((i 0 (+ i 1))) ((= i n))
        (let ((at (+ start i)))
          (when (<= 0 at (- frames 1))
            (let ((w (f64vector-ref window i)))
              (f64vector-set! weight at (+ (f64vector-ref weight at) (* w w)))))))
      (do ((c 0 (+ c 1))) ((= c (audio-channels a)))
        (window-spectrum a c start n window real imag plan)
        (transform c start real imag)
        (fft-execute! plan real imag #:inverse? #t)
        (do ((i 0 (+ i 1))) ((= i n))
          (let ((at (+ start i)))
            (when (<= 0 at (- frames 1))
              (audio-set! out c at (+ (audio-ref out c at)
                                      (* (f64vector-ref real i) (f64vector-ref window i)))))))))
    (audio-map! out (lambda (x c i) (/ x (f64vector-ref weight i))))))
(define (spectral-profile a start end n hop)
  (check-window n hop) (check-region a start end)
  (ensure (>= (- end start) n) 'profile "noise profile must contain at least one complete window")
  (let* ((profiles (list->vector (map (lambda (_) (make-f64vector n 0.0)) (iota (audio-channels a)))))
         (plan (make-fft-plan n)) (window (hann-window n)) (count 0)
         (real (make-f64vector n 0.0)) (imag (make-f64vector n 0.0)))
    (do ((at start (+ at hop))) ((> (+ at n) end))
      (set! count (+ count 1))
      (do ((c 0 (+ c 1))) ((= c (audio-channels a)))
        (window-spectrum a c at n window real imag plan)
        (let ((p (vector-ref profiles c)))
          (do ((k 0 (+ k 1))) ((= k n))
            (f64vector-set! p k (+ (f64vector-ref p k)
                                   (expt (f64vector-ref real k) 2) (expt (f64vector-ref imag k) 2)))))))
    (do ((c 0 (+ c 1))) ((= c (audio-channels a)))
      (let ((p (vector-ref profiles c)))
        (do ((k 0 (+ k 1))) ((= k n)) (f64vector-set! p k (/ (f64vector-ref p k) count))))) profiles))
