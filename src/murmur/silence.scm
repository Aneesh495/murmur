;;; Silence suggestions are measurements, never automatic destructive edits.
;;; Every channel must be quiet. Window accumulation crosses I/O boundaries.
(define-module (murmur silence)
  #:use-module (murmur error)
  #:use-module (murmur buffer)
  #:use-module (murmur dsp envelope)
  #:use-module (srfi srfi-4)
  #:use-module (srfi srfi-9)
  #:export (make-silence-detector silence-add! silence-finish))
(define-record-type <silence-detector>
  (%silence add finish) silence-detector? (add silence-add-proc) (finish silence-finish-proc))
(define (silence-add! d a) ((silence-add-proc d) a))
(define (silence-finish d) ((silence-finish-proc d)))
(define* (make-silence-detector rate channels #:key (threshold-db -45) (minimum 0.4) (padding 0.05))
  (ensure (and (finite-real? threshold-db) (<= -96 threshold-db -6)
               (finite-real? minimum) (<= 0.02 minimum 60)
               (finite-real? padding) (<= 0 padding 1)) 'silence "invalid silence setting")
  (let ((window (max 1 (inexact->exact (round (* rate 0.01)))))
        (limit (expt (db->gain threshold-db) 2))
        (minimum-frames (ceiling (* minimum rate))) (pad (ceiling (* padding rate)))
        (energy (make-f64vector channels 0.0)) (count 0) (at 0)
        (quiet-start #f) (segments '()) (done? #f))
    (define (close-run end)
      (when quiet-start
        (when (and (>= (- end quiet-start) minimum-frames) (< (+ quiet-start pad) (- end pad)))
          (ensure (< (length segments) 4096) 'budget "too many silence suggestions")
          (set! segments (cons (cons (inexact->exact (+ quiet-start pad))
                                     (inexact->exact (- end pad))) segments)))
        (set! quiet-start #f)))
    (define (close-window)
      (when (> count 0)
        (let ((loudest 0.0))
          (do ((c 0 (+ c 1))) ((= c channels))
            (set! loudest (max loudest (/ (f64vector-ref energy c) count)))
            (f64vector-set! energy c 0.0))
          (if (<= loudest limit)
              (unless quiet-start (set! quiet-start (- at count)))
              (close-run (- at count))))
        (set! count 0)))
    (%silence
     (lambda (a)
       (ensure (not done?) 'silence "detector already finalized")
       (ensure (and (= rate (audio-rate a)) (= channels (audio-channels a))) 'format "silence detector format changed")
       (do ((i 0 (+ i 1))) ((= i (audio-frames a)))
         (do ((c 0 (+ c 1))) ((= c channels))
           (let ((x (audio-ref a c i)))
             (f64vector-set! energy c (+ (f64vector-ref energy c) (* x x)))))
         (set! count (+ count 1)) (set! at (+ at 1))
         (when (= count window) (close-window))))
     (lambda ()
       (ensure (not done?) 'silence "detector already finalized")
       (close-window) (close-run at) (set! done? #t) (reverse segments)))))
