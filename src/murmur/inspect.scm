;;; Inspect the bytes that will actually be published, after quantization.
(define-module (murmur inspect)
  #:use-module (murmur error)
  #:use-module (murmur binary)
  #:use-module (murmur wave scan)
  #:use-module (murmur wave decode)
  #:use-module (murmur analyze)
  #:use-module (murmur silence)
  #:use-module (murmur json)
  #:export (analyze-wave inspect-wave))
(define* (analyze-wave path #:key (block-size 4096) (buckets 1200))
  (ensure (exact-integer-in? block-size 1 65536) 'budget "invalid analysis block size")
  (let* ((info (scan-wave path)) (frames (wave-frames info))
         (meter (make-meter (wave-rate info) (wave-channels info) frames buckets))
         (silence (make-silence-detector (wave-rate info) (wave-channels info))))
    (call-with-input-file path
      (lambda (port)
        (seek port (wave-offset info) SEEK_SET)
        (do ((at 0 (+ at block-size))) ((>= at frames))
          (let* ((count (min block-size (- frames at)))
                 (audio (decode-pcm info (read-exact port (* count (wave-align info))))))
            (meter-add! meter audio) (silence-add! silence audio)))) #:binary #t)
    (object (cons 'measurement "sample peak and unweighted RMS")
            (cons 'audio (meter-finish meter))
            (cons 'silenceSuggestions
              (map (lambda (s) (object (cons 'start (car s)) (cons 'end (cdr s))))
                   (silence-finish silence))))))
(define (inspect-wave path)
  (let ((w (scan-wave path)))
    (object (cons 'rate (wave-rate w)) (cons 'channels (wave-channels w))
            (cons 'bits (wave-bits w)) (cons 'format (if (= 1 (wave-format w)) "integer PCM" "IEEE float"))
            (cons 'frames (wave-frames w)) (cons 'duration (/ (wave-frames w) (wave-rate w)))
            (cons 'chunks (map (lambda (chunk) (object (cons 'id (car chunk)) (cons 'bytes (cadr chunk))))
                               (wave-chunks w))))))
