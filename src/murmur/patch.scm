;;; Browser patches bind to both the semantic edit plan and every source digest.
;;; Applying a patch produces a new project beside the original; no in-place edit.
(define-module (murmur patch)
  #:use-module (murmur error)
  #:use-module (murmur paths)
  #:use-module (murmur data)
  #:use-module (murmur schema)
  #:use-module (murmur hash)
  #:use-module (murmur provenance)
  #:use-module (murmur project parse)
  #:use-module (murmur project compile)
  #:use-module (srfi srfi-1)
  #:export (apply-source-patch write-new-project))
(define (write-new-project path form)
  (ensure (not (exists-any? path)) 'exists "project output already exists" path)
  (let ((text (data->text form)))
    ;; O_EXCL is the safety boundary, not the preceding explanatory check.
    (let ((port (open path (logior O_WRONLY O_CREAT O_EXCL) #o600)))
      (dynamic-wind (lambda () #t)
        (lambda () (display text port) (force-output port) (fsync (fileno port)))
        (lambda () (close-port port))))))
(define (apply-source-patch document patch-path output)
  (ensure (string=? (canonicalize-path (dirname document)) (canonicalize-path (dirname output)))
          'path "patched project must be beside its original so relative sources retain their meaning")
  (let* ((form (read-data-file document)) (project (parse-project form))
         (plan (compile-project project document)) (patch (read-data-file patch-path)))
    (ensure (and (list? patch) (pair? patch) (eq? (car patch) 'murmur-patch)) 'patch "expected a murmur-patch document")
    (let* ((f (fields (cdr patch) '(version base-plan source-sha256 redact) '(source-sha256 redact)))
           (pins (field-values f 'source-sha256)) (edits (field-values f 'redact)))
      (ensure (eqv? 1 (field-required f 'version)) 'patch "unsupported patch version")
      (ensure (equal? (plan-digest plan) (field-required f 'base-plan)) 'patch "patch belongs to a different edit plan")
      (ensure (and (= (length pins) (length (plan-sources plan)))
                   (every (lambda (pin) (and (list? pin) (= 2 (length pin))
                                              (symbol? (car pin)) (string? (cadr pin)))) pins)
                   (= (length pins) (length (delete-duplicates (map car pins)))))
              'patch "patch must identify each source exactly once")
      (for-each
       (lambda (s)
         (let ((pin (assq (bound-id s) pins)))
           (ensure (and pin (string=? (bound-digest s) (cadr pin))) 'patch "patch source digest mismatch" (bound-id s))))
       (plan-sources plan))
      (ensure (<= 1 (length edits) 4096) 'patch "patch has no redactions or exceeds edit budget")
      (let* ((next (append form (map (lambda (edit) (cons 'redact edit)) edits)))
             (compiled (compile-project (parse-project next) document)))
        (assert-sources-unchanged compiled)
        (write-new-project output next)
        output))))
