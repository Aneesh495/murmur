(define-module (murmur project parse)
  #:use-module (murmur error)
  #:use-module (murmur clock)
  #:use-module (murmur schema)
  #:use-module (murmur data)
  #:use-module (murmur project model)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-13)
  #:export (parse-project read-project))

(define (named values kind)
  (ensure (and (pair? values) (edit-id? (car values))) 'schema "expected an identifier" kind)
  (car values))
(define (parse-source values)
  (let* ((id (named values 'source)) (f (fields (cdr values) '(path sha256)))
         (path (field-required f 'path)) (digest (field-value f 'sha256)))
    (ensure (path-value? path) 'schema "invalid source path" id)
    (ensure (or (not digest)
                (and (string? digest) (= 64 (string-length digest))
                     (string-every (lambda (c) (or (char<=? #\0 c #\9) (char<=? #\a c #\f))) digest)))
            'schema "SHA-256 must be 64 lowercase hex digits" id)
    (make-source id path digest)))
(define (parse-redaction values)
  (let* ((id (named values 'redact))
         (f (fields (cdr values) '(from to mode guard level-db hz)))
         (from (field-time f 'from)) (to (field-time f 'to))
         (mode (enum-value (field-value f 'mode 'mute) '(mute tone noise)))
         (guard (field-time f 'guard 1/100))
         (level (field-number f 'level-db -96 -3 -18))
         (frequency (field-number f 'hz 20 16000 1000)))
    (ensure (< from to) 'schema "redaction must have positive duration")
    (ensure (<= guard 1) 'schema "redaction guard exceeds one second")
    (make-redaction id from to mode guard level frequency)))
(define (parse-clip values)
  (let* ((id (named values 'clip))
         (f (fields (cdr values) '(source from to at gain-db pan fade-in fade-out)))
         (source (field-required f 'source))
         (from (field-time f 'from 0)) (to (field-time f 'to))
         (at (field-time f 'at 0))
         (gain (field-number f 'gain-db -96 24 0))
         (pan (field-number f 'pan -1 1 0))
         (fi (field-time f 'fade-in 0)) (fo (field-time f 'fade-out 0)))
    (ensure (edit-id? source) 'schema "invalid source identifier")
    (ensure (< from to) 'schema "clip must have positive duration" id)
    (ensure (<= (+ fi fo) (- to from)) 'schema "clip fades overlap" id)
    (make-clip id source from to at gain pan fi fo)))
(define (unique-ids values accessor kind)
  (let ((ids (map accessor values)))
    (ensure (= (length ids) (length (delete-duplicates ids))) 'schema "duplicate identifier" kind)))
(define (parse-marker values)
  (let* ((f (fields values '(at label))) (at (field-time f 'at))
         (label (field-required f 'label)))
    (ensure (label? label) 'schema "invalid marker label") (cons at label)))

(define (parse-project form)
  (ensure (and (list? form) (pair? form) (eq? (car form) 'murmur))
          'schema "expected a murmur document")
  (let* ((f (fields (cdr form) '(version rate channels seed source redact clip effect marker)
                    '(source redact clip effect marker)))
         (version (field-required f 'version)) (rate (field-value f 'rate 48000))
         (channels (field-value f 'channels 2)) (seed (field-value f 'seed 7))
         (sources (map parse-source (field-values f 'source)))
         (redactions (map parse-redaction (field-values f 'redact)))
         (clips (map parse-clip (field-values f 'clip)))
         (effects (field-values f 'effect))
         (markers (map parse-marker (field-values f 'marker))))
    (ensure (eqv? version 1) 'schema "unsupported document version" version)
    (ensure (and (valid-rate? rate) (>= rate 8000)) 'schema "output rate must be 8000 to 384000 Hz")
    (ensure (memv channels '(1 2)) 'schema "output must be mono or stereo")
    (ensure (exact-integer-in? seed 0 #xffffffff) 'schema "invalid seed")
    (ensure (<= 1 (length sources) 64) 'budget "expected one to 64 sources")
    (ensure (<= 1 (length clips) 4096) 'budget "expected one to 4096 clips")
    (ensure (<= (length redactions) 4096) 'budget "too many redactions")
    (ensure (<= (length effects) 32) 'budget "too many effects")
    (unique-ids sources source-id 'source) (unique-ids clips clip-id 'clip)
    (for-each
     (lambda (id) (ensure (find (lambda (s) (eq? id (source-id s))) sources)
                         'schema "unknown source reference" id))
     (append (map clip-source clips) (map redaction-source redactions)))
    (make-project rate channels seed sources redactions clips effects markers)))
(define (read-project path) (parse-project (read-data-file path)))
