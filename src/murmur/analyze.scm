;;; Bounded streaming measurements. Values are sample-peak and unweighted RMS,
;;; explicitly not LUFS or true peak. Waveform buckets cover every output frame.
(define-module (murmur analyze)
  #:use-module (murmur error)
  #:use-module (murmur buffer)
  #:use-module (murmur json)
  #:use-module (murmur dsp envelope)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-4)
  #:use-module (srfi srfi-9)
  #:export (make-meter meter-add! meter-finish meter-frames))
(define-record-type <meter>
  (%meter rate channels total frames sum energy peak clipped lo hi buckets previous crossings)
  meter?
  (rate meter-rate) (channels meter-channels) (total meter-total)
  (frames meter-frames meter-frames-set!) (sum meter-sum) (energy meter-energy)
  (peak meter-peak) (clipped meter-clipped) (lo meter-lo) (hi meter-hi)
  (buckets meter-buckets) (previous meter-previous) (crossings meter-crossings))
(define* (make-meter rate channels total #:optional (buckets 1200))
  (ensure (and (exact-integer-in? channels 1 8) (exact-integer? total) (>= total 0)
               (exact-integer-in? buckets 1 8192)) 'analysis "invalid meter dimensions")
  (let ((buckets (max 1 (min buckets total))))
    (%meter rate channels total 0 (make-f64vector channels 0.0) (make-f64vector channels 0.0)
            (make-f64vector channels 0.0) (make-vector channels 0)
            (list->vector (map (lambda (_) (make-f64vector buckets 0.0)) (iota channels)))
            (list->vector (map (lambda (_) (make-f64vector buckets 0.0)) (iota channels)))
            buckets (make-f64vector channels 0.0) (make-vector channels 0))))
(define (meter-add! m a)
  (ensure (and (= (meter-rate m) (audio-rate a)) (= (meter-channels m) (audio-channels a))
               (<= (+ (meter-frames m) (audio-frames a)) (meter-total m)))
          'analysis "meter received an unexpected audio block")
  (do ((i 0 (+ i 1))) ((= i (audio-frames a)))
    (let* ((frame (+ (meter-frames m) i))
           (bucket (min (- (meter-buckets m) 1)
                        (quotient (* frame (meter-buckets m)) (max 1 (meter-total m))))))
      (do ((c 0 (+ c 1))) ((= c (meter-channels m)))
        (let* ((x (audio-ref a c i)) (lo (vector-ref (meter-lo m) c)) (hi (vector-ref (meter-hi m) c)))
          (ensure (finite-real? x) 'sample "meter received nonfinite sample")
          (f64vector-set! (meter-sum m) c (+ (f64vector-ref (meter-sum m) c) x))
          (f64vector-set! (meter-energy m) c (+ (f64vector-ref (meter-energy m) c) (* x x)))
          (f64vector-set! (meter-peak m) c (max (f64vector-ref (meter-peak m) c) (abs x)))
          (when (>= (abs x) 1) (vector-set! (meter-clipped m) c (+ 1 (vector-ref (meter-clipped m) c))))
          (f64vector-set! lo bucket (min (f64vector-ref lo bucket) x))
          (f64vector-set! hi bucket (max (f64vector-ref hi bucket) x))
          (when (and (> frame 0) (not (eq? (< x 0) (< (f64vector-ref (meter-previous m) c) 0))))
            (vector-set! (meter-crossings m) c (+ 1 (vector-ref (meter-crossings m) c))))
          (f64vector-set! (meter-previous m) c x)))))
  (meter-frames-set! m (+ (meter-frames m) (audio-frames a))) m)
(define (meter-finish m)
  (ensure (= (meter-frames m) (meter-total m)) 'analysis "incomplete meter stream")
  (let ((n (max 1 (meter-frames m))))
    (object
     (cons 'rate (meter-rate m)) (cons 'frames (meter-frames m))
     (cons 'duration (/ (meter-frames m) (meter-rate m)))
     (cons 'channels
       (map (lambda (c)
              (let* ((rms (sqrt (/ (f64vector-ref (meter-energy m) c) n)))
                     (peak (f64vector-ref (meter-peak m) c)))
                (object (cons 'peak peak) (cons 'peakDb (gain->db peak)) (cons 'rms rms)
                        (cons 'rmsDb (gain->db rms)) (cons 'dc (/ (f64vector-ref (meter-sum m) c) n))
                        (cons 'crestDb (if (zero? rms) 0 (- (gain->db peak) (gain->db rms))))
                        (cons 'clippedSamples (vector-ref (meter-clipped m) c))
                        (cons 'zeroCrossings (vector-ref (meter-crossings m) c))))) (iota (meter-channels m))))
     (cons 'waveform
       (map (lambda (c)
              (map (lambda (i) (list (f64vector-ref (vector-ref (meter-lo m) c) i)
                                     (f64vector-ref (vector-ref (meter-hi m) c) i))) (iota (meter-buckets m))))
            (iota (meter-channels m)))))))
