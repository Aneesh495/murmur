;;; The effect registry is also its schema. Validation and coefficient design
;;; happen before output staging; factories create fresh state for each render.
(define-module (murmur effects)
  #:use-module (murmur error)
  #:use-module (murmur schema)
  #:use-module (murmur clock)
  #:use-module (murmur buffer)
  #:use-module (murmur dsp envelope)
  #:use-module (murmur dsp biquad)
  #:use-module (murmur dsp dynamics)
  #:use-module (murmur dsp fft)
  #:use-module (murmur dsp repair)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-9)
  #:export (compile-effects effect-kind effect-spec effects-offline? make-effect-chain))
(define-record-type <effect>
  (%effect kind spec offline factory) effect?
  (kind effect-kind) (spec effect-spec) (offline effect-offline?) (factory effect-factory))
(define (gain-processor gain)
  (lambda (a) (audio-map! a (lambda (x c i) (* gain x)))))
(define (compile-effect spec rate frames)
  (ensure (and (list? spec) (pair? spec) (symbol? (car spec))) 'effect "effect needs a type")
  (let* ((kind (car spec))
         (allowed (case kind
                    ((gain) '(db))
                    ((highpass lowpass notch peak low-shelf high-shelf) '(hz q gain-db))
                    ((compress) '(threshold-db ratio knee-db attack-ms release-ms makeup-db))
                    ((gate) '(threshold-db hysteresis-db hold-ms attack-ms release-ms range-db))
                    ((limit) '(ceiling-db release-ms))
                    ((declick) '(threshold sensitivity radius))
                    ((denoise) '(profile-from profile-to size strength floor-db smoothing))
                    ((normalize) '(peak-db max-gain-db))
                    ((remove-dc) '())
                    (else (fail 'effect "unknown effect" kind))))
         (f (fields (cdr spec) allowed)))
    (define (num key lo hi default) (field-number f key lo hi default))
    (define (result offline factory) (%effect kind spec offline factory))
    (case kind
      ((gain)
       (let ((gain (db->gain (num 'db -96 36 0))))
         (result #f (lambda (channels) (gain-processor gain)))))
      ((highpass lowpass notch peak low-shelf high-shelf)
       (let ((c (biquad-coefficients kind rate (num 'hz 1 (- (/ rate 2) 1) 80)
                   #:q (num 'q 0.1 20 0.7071067811865476) #:gain-db (num 'gain-db -36 36 0))))
         (result #f (lambda (channels) (make-biquad rate channels c)))))
      ((compress)
       (let ((threshold (num 'threshold-db -96 0 -18)) (ratio (num 'ratio 1 100 3))
             (knee (num 'knee-db 0 36 6)) (attack (num 'attack-ms 0.01 10000 10))
             (release (num 'release-ms 0.01 10000 120)) (makeup (num 'makeup-db -24 24 0)))
         (result #f (lambda (channels)
                      (make-compressor rate channels #:threshold threshold #:ratio ratio #:knee knee
                                       #:attack attack #:release release #:makeup makeup)))))
      ((gate)
       (let ((threshold (num 'threshold-db -96 0 -45)) (hysteresis (num 'hysteresis-db 0 24 6))
             (hold (num 'hold-ms 0 10000 80)) (attack (num 'attack-ms 0.01 10000 5))
             (release (num 'release-ms 0.01 10000 120)) (range (num 'range-db -96 0 -40)))
         (result #f (lambda (channels)
                      (make-gate rate channels #:threshold threshold #:hysteresis hysteresis #:hold hold
                                 #:attack attack #:release release #:range-db range)))))
      ((limit)
       (let ((ceiling (num 'ceiling-db -24 0 -1)) (release (num 'release-ms 0.01 10000 80)))
         (result #f (lambda (channels) (make-limiter rate channels #:ceiling-db ceiling #:release release)))))
      ((declick)
       (let ((threshold (num 'threshold 0.001 1 0.15)) (sensitivity (num 'sensitivity 2 50 8))
             (radius (num 'radius 2 16 3)))
         (ensure (exact-integer? radius) 'effect "declick radius must be an integer")
         (result #t (lambda (channels)
                      (lambda (a) (repair-clicks a #:threshold threshold #:sensitivity sensitivity #:radius radius))))))
      ((denoise)
       (let ((from (seconds->frame (field-time f 'profile-from) rate))
             (to (seconds->frame (field-time f 'profile-to) rate))
             (size (num 'size 32 8192 512)) (strength (num 'strength 0 4 1.2))
             (floor-db (num 'floor-db -60 0 -18)) (smoothing (num 'smoothing 0 0.99 0.6)))
         (ensure (and (power-of-two? size) (<= 0 from) (<= (+ from size) to frames))
                 'effect "invalid denoise profile interval or FFT size")
         (result #t (lambda (channels)
                      (lambda (a) (spectral-denoise a from to #:size size #:strength strength
                                                    #:floor-db floor-db #:smoothing smoothing))))))
      ((normalize)
       (let ((target (db->gain (num 'peak-db -24 0 -1))) (maximum (db->gain (num 'max-gain-db 0 36 18))))
         (result #t (lambda (channels)
                      (lambda (a)
                        (let* ((peak (audio-peak a)) (gain (if (zero? peak) 1 (min maximum (/ target peak)))))
                          ((gain-processor gain) a)))))))
      ((remove-dc)
       (result #t (lambda (channels)
                    (lambda (a)
                      (do ((c 0 (+ c 1))) ((= c channels))
                        (let ((sum 0.0))
                          (do ((i 0 (+ i 1))) ((= i (audio-frames a))) (set! sum (+ sum (audio-ref a c i))))
                          (let ((mean (/ sum (max 1 (audio-frames a)))))
                            (do ((i 0 (+ i 1))) ((= i (audio-frames a)))
                              (audio-set! a c i (- (audio-ref a c i) mean)))))) a)))))))
(define (compile-effects specs rate frames)
  (map (lambda (s) (compile-effect s rate frames)) specs))
(define (effects-offline? effects) (any effect-offline? effects))
(define (make-effect-chain effects channels)
  (let ((processors (map (lambda (e) ((effect-factory e) channels)) effects)))
    (lambda (audio)
      (fold (lambda (process a)
              (let ((result (process a)))
                (ensure (audio-finite? result) 'sample "effect produced a nonfinite sample") result))
            audio processors))))
