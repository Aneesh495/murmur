;;; Small binary primitives centralize bounds checks. RIFF offsets are exact
;;; integers, including offsets supplied by an untrusted chunk length.
(define-module (murmur binary)
  #:use-module (murmur error)
  #:use-module (rnrs bytevectors)
  #:use-module (ice-9 binary-ports)
  #:export (u16le u32le s16le s24le s32le put-u16le! put-u32le!
            fourcc fourcc! bytes-slice bytes-append read-exact read-file-bytes
            write-file-bytes check-bytes bytes->hex))

(define (check-bytes bytes offset count)
  (ensure (and (bytevector? bytes) (exact-integer? offset) (exact-integer? count)
               (<= 0 offset) (<= 0 count)
               (<= (+ offset count) (bytevector-length bytes)))
          'truncated "binary field exceeds available bytes" offset count))
(define (u16le b o)
  (check-bytes b o 2) (bytevector-u16-ref b o (endianness little)))
(define (u32le b o)
  (check-bytes b o 4) (bytevector-u32-ref b o (endianness little)))
(define (s16le b o)
  (check-bytes b o 2) (bytevector-s16-ref b o (endianness little)))
(define (s32le b o)
  (check-bytes b o 4) (bytevector-s32-ref b o (endianness little)))
(define (s24le b o)
  (check-bytes b o 3)
  (let ((n (+ (bytevector-u8-ref b o)
              (ash (bytevector-u8-ref b (+ o 1)) 8)
              (ash (bytevector-u8-ref b (+ o 2)) 16))))
    (if (>= n #x800000) (- n #x1000000) n)))
(define (put-u16le! b o n)
  (check-bytes b o 2) (bytevector-u16-set! b o n (endianness little)))
(define (put-u32le! b o n)
  (check-bytes b o 4) (bytevector-u32-set! b o n (endianness little)))
(define (fourcc b o)
  (check-bytes b o 4)
  (list->string (map (lambda (i) (integer->char (bytevector-u8-ref b (+ o i))))
                    '(0 1 2 3))))
(define (fourcc! b o text)
  (ensure (= 4 (string-length text)) 'binary "FourCC must have four characters")
  (check-bytes b o 4)
  (do ((i 0 (+ i 1))) ((= i 4))
    (bytevector-u8-set! b (+ o i) (char->integer (string-ref text i)))))
(define (bytes-slice b start end)
  (check-bytes b start (- end start))
  (let ((out (make-bytevector (- end start))))
    (bytevector-copy! b start out 0 (- end start)) out))
(define (bytes-append . parts)
  (let* ((n (apply + (map bytevector-length parts))) (out (make-bytevector n)))
    (let loop ((parts parts) (at 0))
      (unless (null? parts)
        (let ((n (bytevector-length (car parts))))
          (bytevector-copy! (car parts) 0 out at n)
          (loop (cdr parts) (+ at n))))) out))
(define (read-exact port count)
  (let ((b (get-bytevector-n port count)))
    (ensure (and (bytevector? b) (= count (bytevector-length b)))
            'truncated "unexpected end of file" count)
    b))
(define* (read-file-bytes path #:optional (limit (* 256 1024 1024)))
  (let ((size (stat:size (stat path))))
    (ensure (<= size limit) 'budget "file exceeds input budget" size limit)
    (call-with-input-file path (lambda (p) (read-exact p size)) #:binary #t)))
(define (write-file-bytes path bytes)
  (call-with-output-file path (lambda (p) (put-bytevector p bytes)) #:binary #t))
(define (bytes->hex bytes)
  (let ((digits "0123456789abcdef") (out (make-string (* 2 (bytevector-length bytes)))))
    (do ((i 0 (+ i 1))) ((= i (bytevector-length bytes)))
      (let ((v (bytevector-u8-ref bytes i)))
        (string-set! out (* 2 i) (string-ref digits (ash v -4)))
        (string-set! out (+ 1 (* 2 i)) (string-ref digits (logand v 15))))) out))
