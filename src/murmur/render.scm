;;; One transaction: validate, render privately, inspect encoded bytes, bind
;;; artifacts, recheck sources, verify the bundle, and publish with no replace.
(define-module (murmur render)
  #:use-module (murmur error)
  #:use-module (murmur buffer)
  #:use-module (murmur paths)
  #:use-module (murmur project parse)
  #:use-module (murmur project model)
  #:use-module (murmur project compile)
  #:use-module (murmur wave stream)
  #:use-module (murmur mix)
  #:use-module (murmur effects)
  #:use-module (murmur inspect)
  #:use-module (murmur bundle)
  #:use-module (murmur review)
  #:export (render-project render-plan))
(define* (render-plan plan destination #:key (block-size 4096) (bits 16) (sample-format 1) (dither #t))
  (ensure (exact-integer-in? block-size 1 65536) 'budget "block size must be 1 to 65536 frames")
  (ensure (or (and (= sample-format 1) (memv bits '(16 24 32)))
              (and (= sample-format 3) (memv bits '(32 64)))) 'format "unsupported render format")
  (let* ((project (plan-project plan)) (rate (project-rate project))
         (channels (project-channels project)) (frames (plan-frames plan))
         (effects (compile-effects (project-effects project) rate frames))
         (offline? (effects-offline? effects)) (process (make-effect-chain effects channels)))
    (when offline?
      (ensure (<= (* 3 8 channels frames) (max-buffer-bytes))
              'budget "offline effects require three full-buffer equivalents within the memory limit"))
    (with-source-readers (plan-sources plan)
      (lambda (readers)
        (let ((mix (make-mixer plan readers)))
          (with-staging-directory destination
            (lambda (stage)
              (call-with-wave-writer (string-append stage "/audio.wav") rate channels frames
                (lambda (put)
                  (define (emit block)
                    (ensure (audio-finite? block) 'sample "render produced nonfinite audio")
                    (ensure (<= (audio-peak block) 1.000000000001)
                            'clipping "render exceeds full scale; add a limiter or reduce clip gain")
                    (put block))
                  (if offline?
                      (let ((audio (process (mix 0 frames))))
                        (do ((at 0 (+ at block-size))) ((>= at frames))
                          (emit (audio-slice audio at (min frames (+ at block-size))))))
                      (do ((at 0 (+ at block-size))) ((>= at frames))
                        (emit (process (mix at (min block-size (- frames at))))))))
                #:bits bits #:format sample-format #:dither (and dither (project-seed project)))
              (let ((analysis (analyze-wave (string-append stage "/audio.wav"))))
                (write-review stage plan analysis)
                (write-bundle-metadata stage plan analysis))
              (assert-sources-unchanged plan)
              (verify-bundle stage)
              (absolute-output destination))))))))
(define* (render-project document destination #:key (block-size 4096) (bits 16) (sample-format 1) (dither #t))
  (render-plan (compile-project (read-project document) document) destination
               #:block-size block-size #:bits bits #:sample-format sample-format #:dither dither))
