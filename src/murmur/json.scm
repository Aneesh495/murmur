;;; A tiny output-only JSON encoder. Object values are explicit records so an
;;; empty object cannot be confused with an empty array. Strings are safe when
;;; embedded in a script element as well as in a standalone JSON document.
(define-module (murmur json)
  #:use-module (murmur error)
  #:use-module (srfi srfi-9)
  #:use-module (srfi srfi-1)
  #:use-module (ice-9 format)
  #:export (object json-null json->text write-json))
(define-record-type <object>
  (%object fields) object? (fields object-fields))
(define json-null (list 'json-null))
(define (object . fields)
  (ensure (every (lambda (f) (and (pair? f) (or (string? (car f)) (symbol? (car f))))) fields)
          'json "object fields must have string or symbol keys")
  (%object fields))
(define (quoted text port)
  (display #\" port)
  (string-for-each
   (lambda (c)
     (case c
       ((#\") (display "\\\"" port)) ((#\\) (display "\\\\" port))
       ((#\newline) (display "\\n" port)) ((#\return) (display "\\r" port))
       ((#\tab) (display "\\t" port))
       (else
        (let ((n (char->integer c)))
          (if (or (< n 32) (memv n '(60 62 38 8232 8233)))
              (format port "\\u~4,'0x" n) (display c port)))))) text)
  (display #\" port))
(define (separated items emit port)
  (let loop ((rest items) (first #t))
    (unless (null? rest)
      (unless first (display #\, port))
      (emit (car rest)) (loop (cdr rest) #f))))
(define (write-json value port)
  (cond
   ((eq? value json-null) (display "null" port))
   ((eq? value #t) (display "true" port)) ((eq? value #f) (display "false" port))
   ((object? value)
    (display #\{ port)
    (separated (object-fields value)
      (lambda (field)
        (quoted (if (symbol? (car field)) (symbol->string (car field)) (car field)) port)
        (display #\: port) (write-json (cdr field) port)) port)
    (display #\} port))
   ((or (list? value) (vector? value))
    (display #\[ port)
    (separated (if (vector? value) (vector->list value) value)
               (lambda (x) (write-json x port)) port)
    (display #\] port))
   ((string? value) (quoted value port))
   ((symbol? value) (quoted (symbol->string value) port))
   ((finite-real? value)
    (display (if (integer? value) (number->string (inexact->exact value))
                 (number->string (exact->inexact value))) port))
   (else (fail 'json "unsupported JSON value" value))))
(define (json->text value)
  (call-with-output-string (lambda (p) (write-json value p) (newline p))))
