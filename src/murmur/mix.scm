;;; Compile per-clip samplers once, then pull arbitrary output blocks. There is
;;; no block-local phase accumulator, so output cannot drift with block size.
(define-module (murmur mix)
  #:use-module (murmur error)
  #:use-module (murmur buffer)
  #:use-module (murmur project model)
  #:use-module (murmur project compile)
  #:use-module (murmur wave scan)
  #:use-module (murmur wave stream)
  #:use-module (murmur dsp resample)
  #:use-module (murmur dsp envelope)
  #:use-module (srfi srfi-1)
  #:export (make-mixer render-mix))

(define (make-mixer plan readers)
  (let* ((project (plan-project plan)) (rate (project-rate project))
         (channels (project-channels project)) (kernels '()) (kernel-bytes 0)
         (clips
          (map
           (lambda (c)
             (let* ((edit (compiled-edit c)) (source (compiled-source c))
                    (info (bound-info source)) (native (wave-rate info))
                    (reader (assq-ref readers (bound-id source)))
                    (cached (assv native kernels))
                    (resampler (if cached (cdr cached) (make-resampler native rate)))
                    (source-channels (wave-channels info))
                    (gain (db->gain (clip-gain edit)))
                    (pan (if (= source-channels 1) (pan-gains (clip-pan edit)) (balance-gains (clip-pan edit)))))
               (ensure (<= source-channels 2) 'channels "timeline sources must be mono or stereo")
               (when (= channels 1)
                 (ensure (zero? (clip-pan edit)) 'pan "pan requires stereo output"))
               (unless cached
                 (set! kernel-bytes (+ kernel-bytes (resampler-bytes resampler)))
                 (ensure (<= kernel-bytes (* 64 1024 1024)) 'budget "session resampling tables exceed budget")
                 (set! kernels (cons (cons native resampler) kernels)))
               (let ((left (lambda (j)
                             (source-reader-ref reader 0
                               (max (compiled-start c) (min (- (compiled-end c) 1) (+ (compiled-start c) j))))))
                     (right (lambda (j)
                              (source-reader-ref reader (- source-channels 1)
                                (max (compiled-start c) (min (- (compiled-end c) 1) (+ (compiled-start c) j)))))))
                 (list c resampler source-channels gain pan left right))))
           (plan-clips plan))))
    (lambda (start frames)
      (ensure (and (exact-integer? start) (exact-integer? frames)
                   (<= 0 start) (<= 0 frames) (<= (+ start frames) (plan-frames plan)))
              'bounds "output block exceeds the render plan")
      (let ((out (make-audio rate channels frames)))
        (for-each
         (lambda (entry)
           (let* ((c (list-ref entry 0)) (r (list-ref entry 1)) (source-channels (list-ref entry 2))
                  (gain (list-ref entry 3)) (pan (list-ref entry 4))
                  (left (list-ref entry 5)) (right (list-ref entry 6))
                  (lo (max start (compiled-at c)))
                  (hi (min (+ start frames) (+ (compiled-at c) (compiled-frames c)))))
             (do ((global lo (+ global 1))) ((>= global hi))
               (let* ((i (- global (compiled-at c))) (at (- global start))
                      (fade (* gain (fade-weight i (compiled-frames c) (compiled-fade-in c) (compiled-fade-out c))))
                      (l (resampler-ref r left i))
                      (rval (if (= source-channels 1) l (resampler-ref r right i))))
                 (if (= channels 1)
                     (audio-set! out 0 at (+ (audio-ref out 0 at) (* fade (/ (+ l rval) 2))))
                     (begin
                       (audio-set! out 0 at (+ (audio-ref out 0 at) (* fade (car pan) l)))
                       (audio-set! out 1 at (+ (audio-ref out 1 at) (* fade (cdr pan) rval))))))))) clips)
        out))))
(define (render-mix plan)
  (with-source-readers (plan-sources plan)
    (lambda (readers) ((make-mixer plan readers) 0 (plan-frames plan)))))
