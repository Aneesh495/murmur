;;; Project files are data. This bounded parser does not invoke Guile's reader,
;;; reader extensions, evaluator, imports, or macro expander.
(define-module (murmur data)
  #:use-module (murmur error)
  #:use-module (murmur binary)
  #:use-module (rnrs bytevectors)
  #:use-module (ice-9 regex)
  #:use-module (srfi srfi-13)
  #:export (parse-data read-data-file data->text))

(define number-pattern "^-?[0-9]+(\\.[0-9]+|/[0-9]+)?$")
(define symbol-pattern "^[a-z][a-z0-9-]*$")

(define* (parse-data text #:key (max-depth 32) (max-nodes 50000))
  (ensure (and (string? text) (<= (string-length text) 1048576))
          'budget "project text exceeds one MiB")
  (let ((at 0) (line 1) (column 1) (nodes 0) (n (string-length text)))
    (define (bad message) (fail 'parse message line column))
    (define (peek) (and (< at n) (string-ref text at)))
    (define (pop)
      (let ((c (peek)))
        (when c
          (set! at (+ at 1))
          (if (char=? c #\newline) (begin (set! line (+ line 1)) (set! column 1))
              (set! column (+ column 1)))) c))
    (define (space)
      (let loop ()
        (cond ((and (peek) (char-whitespace? (peek))) (pop) (loop))
              ((eqv? (peek) #\;)
               (let comment ()
                 (when (and (peek) (not (eqv? (pop) #\newline))) (comment))) (loop)))))
    (define (quoted)
      (pop)
      (let loop ((out '()) (size 0))
        (when (> size 4096) (bad "string exceeds 4096 characters"))
        (let ((c (pop)))
          (cond
           ((not c) (bad "unterminated string"))
           ((char=? c #\") (list->string (reverse out)))
           ((char=? c #\\)
            (let* ((e (pop)) (v (case e ((#\n) #\newline) ((#\r) #\return)
                                  ((#\t) #\tab) ((#\\) #\\) ((#\") #\") (else #f))))
              (unless v (bad "unsupported string escape"))
              (loop (cons v out) (+ size 1))))
           ((< (char->integer c) 32) (bad "unescaped control character"))
           (else (loop (cons c out) (+ size 1)))))))
    (define (atom)
      (let ((start at))
        (let loop ()
          (when (and (peek) (not (char-whitespace? (peek)))
                     (not (memv (peek) '(#\( #\) #\;))))
            (pop) (when (> (- at start) 128) (bad "atom exceeds 128 characters")) (loop)))
        (let ((token (substring text start at)))
          (cond
           ((string-match number-pattern token)
            (let ((value (string->number (string-append "#e" token))))
              (unless (and value (rational? value) (exact? value)) (bad "invalid exact number"))
              value))
           ((string-match symbol-pattern token) (string->symbol token))
           (else (bad "expected a symbol, exact number, string, or list"))))))
    (define (datum depth)
      (space)
      (set! nodes (+ nodes 1))
      (when (> nodes max-nodes) (fail 'budget "project has too many data nodes"))
      (when (> depth max-depth) (fail 'budget "project nesting exceeds limit"))
      (cond
       ((not (peek)) (bad "expected a value"))
       ((eqv? (peek) #\)) (bad "unexpected closing parenthesis"))
       ((eqv? (peek) #\") (quoted))
       ((eqv? (peek) #\()
        (pop)
        (let loop ((items '()))
          (space)
          (cond ((not (peek)) (bad "unterminated list"))
                ((eqv? (peek) #\)) (pop) (reverse items))
                (else (loop (cons (datum (+ depth 1)) items))))))
       (else (atom))))
    (let ((value (datum 0)))
      (space) (when (peek) (bad "expected exactly one document")) value)))

(define (read-data-file path)
  (let ((bytes (read-file-bytes path 1048576)))
    (catch 'decoding-error
      (lambda () (parse-data (utf8->string bytes)))
      (lambda args (fail 'parse "project must be valid UTF-8")))))

(define (data->text value)
  ;; Validate the emitted subset as well, so internal callers cannot emit forms
  ;; that a subsequent import would interpret differently.
  (let ((text (call-with-output-string (lambda (p) (write value p) (newline p)))))
    (parse-data text) text))
