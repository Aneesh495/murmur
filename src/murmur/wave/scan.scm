;;; A RIFF file is a chunk container, not a 44-byte header. Scan metadata using
;;; bounded reads and absolute offsets; unknown chunks are skipped, never copied.
(define-module (murmur wave scan)
  #:use-module (murmur error)
  #:use-module (murmur binary)
  #:use-module (murmur clock)
  #:use-module (rnrs bytevectors)
  #:use-module (srfi srfi-9)
  #:use-module (srfi srfi-1)
  #:export (scan-wave wave-info? wave-rate wave-channels wave-bits wave-format
            wave-offset wave-size wave-frames wave-align wave-chunks))

(define-record-type <wave-info>
  (%wave rate channels bits format offset size align chunks)
  wave-info?
  (rate wave-rate) (channels wave-channels) (bits wave-bits)
  (format wave-format) (offset wave-offset) (size wave-size)
  (align wave-align) (chunks wave-chunks))
(define (wave-frames w) (quotient (wave-size w) (wave-align w)))

(define (parse-format b)
  (ensure (>= (bytevector-length b) 16) 'wave "short format chunk")
  (let* ((tag (u16le b 0)) (channels (u16le b 2)) (rate (u32le b 4))
         (bytes/sec (u32le b 8)) (align (u16le b 12)) (bits (u16le b 14))
         (format
          (if (= tag #xfffe)
              (begin
                (ensure (and (= (bytevector-length b) 40) (= (u16le b 16) 22))
                        'wave "invalid extensible format size")
                (ensure (= bits (u16le b 18)) 'wave "reduced valid-bit formats are unsupported")
                (ensure (equal? (bytes-slice b 26 40)
                                #vu8(0 0 0 0 16 0 128 0 0 170 0 56 155 113))
                        'wave "unknown extensible subformat GUID")
                (u16le b 24)) tag)))
    (ensure (exact-integer-in? channels 1 8) 'wave "unsupported channel count")
    (ensure (valid-rate? rate) 'wave "unsupported sample rate")
    (ensure (or (and (= format 1) (memv bits '(8 16 24 32)))
                (and (= format 3) (memv bits '(32 64))))
            'wave "expected integer or IEEE floating point PCM" tag bits)
    (ensure (and (= align (* channels (quotient bits 8)))
                 (= bytes/sec (* rate align)))
            'wave "inconsistent PCM block alignment or byte rate")
    (ensure (or (= tag #xfffe)
                (and (= format 1) (= (bytevector-length b) 16))
                (and (= (bytevector-length b) 18) (= (u16le b 16) 0)))
            'wave "unsupported format extension")
    (list rate channels bits format align)))

(define (scan-wave path)
  (call-with-input-file path
    (lambda (p)
      (let* ((actual (seek p 0 SEEK_END))
             (_ (seek p 0 SEEK_SET)) (header (read-exact p 12))
             (end (+ 8 (u32le header 4))))
        (ensure (and (string=? "RIFF" (fourcc header 0))
                     (string=? "WAVE" (fourcc header 8)))
                'wave "expected little-endian RIFF WAVE")
        (ensure (= end actual) 'wave "RIFF size differs from file size" end actual)
        (let loop ((at 12) (format #f) (data #f) (chunks '()) (count 0))
          (if (= at end)
              (begin
                (ensure (and format data) 'wave "missing format or data chunk")
                (let ((align (list-ref format 4)))
                  (ensure (zero? (modulo (cdr data) align)) 'wave "partial PCM frame")
                  (apply %wave (append (take format 4)
                                       (list (car data) (cdr data) align (reverse chunks))))))
              (begin
                (ensure (< count 4096) 'budget "too many RIFF chunks")
                (ensure (<= (+ at 8) end) 'wave "partial RIFF chunk header")
                (seek p at SEEK_SET)
                (let* ((h (read-exact p 8)) (id (fourcc h 0)) (size (u32le h 4))
                       (start (+ at 8)) (next (+ start size (modulo size 2))))
                  (ensure (<= next end) 'wave "chunk exceeds RIFF boundary" id)
                  (cond
                   ((string=? id "fmt ")
                    (ensure (not format) 'wave "duplicate format chunk")
                    (ensure (<= size 64) 'wave "oversized format chunk")
                    (loop next (parse-format (read-exact p size)) data
                          (cons (list id size) chunks) (+ count 1)))
                   ((string=? id "data")
                    (ensure (not data) 'wave "duplicate data chunk")
                    (loop next format (cons start size)
                          (cons (list id size) chunks) (+ count 1)))
                   (else (loop next format data (cons (list id size) chunks) (+ count 1))))))))))
    #:binary #t))
