;;; Convert interleaved PCM to planar doubles. Floating input may exceed full
;;; scale, but NaN and infinity are rejected before they reach a DSP state.
(define-module (murmur wave decode)
  #:use-module (murmur error)
  #:use-module (murmur binary)
  #:use-module (murmur buffer)
  #:use-module (murmur wave scan)
  #:use-module (rnrs bytevectors)
  #:export (decode-pcm read-wave read-wave-region))

(define (decode-pcm info bytes)
  (let* ((align (wave-align info)) (bits (wave-bits info))
         (width (quotient bits 8)) (channels (wave-channels info))
         (frames (quotient (bytevector-length bytes) align))
         (out (make-audio (wave-rate info) channels frames)))
    (ensure (zero? (modulo (bytevector-length bytes) align)) 'wave "partial PCM block")
    (do ((i 0 (+ i 1))) ((= i frames))
      (do ((c 0 (+ c 1))) ((= c channels))
        (let* ((at (+ (* i align) (* c width)))
               (x (if (= 3 (wave-format info))
                      (if (= bits 32)
                          (bytevector-ieee-single-ref bytes at (endianness little))
                          (bytevector-ieee-double-ref bytes at (endianness little)))
                      (case bits
                        ((8) (/ (- (bytevector-u8-ref bytes at) 128) 128.0))
                        ((16) (/ (s16le bytes at) 32768.0))
                        ((24) (/ (s24le bytes at) 8388608.0))
                        ((32) (/ (s32le bytes at) 2147483648.0))))))
          (ensure (finite-real? x) 'sample "nonfinite PCM sample" i c)
          (audio-set! out c i x)))) out))

(define (read-wave-region path info start end)
  (ensure (and (exact-integer? start) (exact-integer? end)
               (<= 0 start end (wave-frames info))) 'bounds "invalid WAV frame range")
  (ensure (<= (* 8 (wave-channels info) (- end start)) (max-buffer-bytes))
          'budget "decoded WAV exceeds memory budget")
  (call-with-input-file path
    (lambda (p)
      (seek p (+ (wave-offset info) (* start (wave-align info))) SEEK_SET)
      (decode-pcm info (read-exact p (* (- end start) (wave-align info))))) #:binary #t))

(define (read-wave path)
  (let ((info (scan-wave path)))
    (read-wave-region path info 0 (wave-frames info))))
