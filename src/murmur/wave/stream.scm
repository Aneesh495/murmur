;;; Streaming endpoints own their ports. The reader caches a fixed number of
;;; sanitized pages; forbidden samples never enter a resampler or effect state.
(define-module (murmur wave stream)
  #:use-module (murmur error)
  #:use-module (murmur binary)
  #:use-module (murmur buffer)
  #:use-module (murmur fingerprint)
  #:use-module (murmur redact)
  #:use-module (murmur wave scan)
  #:use-module (murmur wave decode)
  #:use-module (murmur wave encode)
  #:use-module (murmur project compile)
  #:use-module (ice-9 binary-ports)
  #:use-module (rnrs bytevectors)
  #:use-module (srfi srfi-9)
  #:export (open-source-reader close-source-reader source-reader-ref
            source-reader-page-loads with-source-readers call-with-wave-writer))
(define page-frames 4096)
(define cache-pages 4)
(define-record-type <source-reader>
  (%reader source port cache loads) source-reader?
  (source reader-source) (port reader-port) (cache reader-cache)
  (loads source-reader-page-loads reader-loads-set!))
(define (open-source-reader source)
  (%reader source (open-file (bound-path source) "rb") (make-vector cache-pages #f) 0))
(define (close-source-reader r) (close-port (reader-port r)))
(define (source-reader-ref r channel frame)
  (let* ((s (reader-source r)) (info (bound-info s))
         (page (quotient frame page-frames)) (slot (modulo page cache-pages))
         (cached (vector-ref (reader-cache r) slot)))
    (ensure (and (exact-integer-in? channel 0 (- (wave-channels info) 1))
                 (exact-integer-in? frame 0 (- (wave-frames info) 1)))
            'bounds "sample read outside source")
    (unless (and cached (= page (car cached)))
      (let* ((start (* page page-frames)) (frames (min page-frames (- (wave-frames info) start)))
             (port (reader-port r)))
        (ensure (equal? (bound-fingerprint s) (file-fingerprint port))
                'source "source changed before a page read" (bound-id s))
        (seek port (+ (wave-offset info) (* start (wave-align info))) SEEK_SET)
        (let ((audio (decode-pcm info (read-exact port (* frames (wave-align info))))))
          (ensure (equal? (bound-fingerprint s) (file-fingerprint port))
                  'source "source changed during a page read" (bound-id s))
          (redact-buffer! audio (bound-masks s) (bound-seed s) start)
          (set! cached (cons page audio)) (vector-set! (reader-cache r) slot cached)
          (reader-loads-set! r (+ 1 (source-reader-page-loads r))))))
    (audio-ref (cdr cached) channel (modulo frame page-frames))))
(define (with-source-readers sources proc)
  (let ((opened '()))
    (dynamic-wind
      (lambda () #t)
      (lambda ()
        (for-each (lambda (s) (set! opened (cons (cons (bound-id s) (open-source-reader s)) opened))) sources)
        (proc opened))
      (lambda () (for-each (lambda (entry) (close-source-reader (cdr entry))) opened)))))

(define* (call-with-wave-writer path rate channels frames proc
                                #:key (bits 16) (format 1) (dither #f))
  (call-with-output-file path
    (lambda (port)
      (put-bytevector port (wave-header rate channels frames bits format))
      (let ((written 0))
        (proc
         (lambda (block)
           (ensure (and (= rate (audio-rate block)) (= channels (audio-channels block)))
                   'format "writer received a different audio format")
           (ensure (<= (+ written (audio-frames block)) frames) 'wave "writer received too many frames")
           (put-bytevector port (encode-pcm block #:bits bits #:format format #:dither dither #:start-frame written))
           (set! written (+ written (audio-frames block)))))
        (ensure (= written frames) 'wave "writer did not receive the declared frame count" written frames)
        (when (odd? (* frames channels (quotient bits 8))) (put-u8 port 0))
        (force-output port)
        (fsync (fileno port)))) #:binary #t))
