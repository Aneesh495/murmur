;;; Fresh output headers intentionally omit input metadata. Integer PCM uses
;;; asymmetric signed extrema; positive full scale saturates to scale minus one.
(define-module (murmur wave encode)
  #:use-module (murmur error)
  #:use-module (murmur binary)
  #:use-module (murmur buffer)
  #:use-module (murmur clock)
  #:use-module (murmur random)
  #:use-module (rnrs bytevectors)
  #:export (encode-pcm wave-header encode-wave write-wave))

(define (chunk id body)
  (let ((h (make-bytevector 8 0)))
    (fourcc! h 0 id) (put-u32le! h 4 (bytevector-length body))
    (bytes-append h body)))

(define (check-format rate channels frames bits format)
  (ensure (and (valid-rate? rate) (exact-integer-in? channels 1 8)
               (exact-integer? frames) (>= frames 0)) 'wave "invalid WAV dimensions")
  (ensure (or (and (= format 1) (memv bits '(8 16 24 32)))
              (and (= format 3) (memv bits '(32 64)))) 'wave "unsupported output format"))

(define* (wave-header rate channels frames #:optional (bits 16) (format 1))
  (check-format rate channels frames bits format)
  (let* ((align (* channels (quotient bits 8))) (size (* frames align))
         (ext (and (= format 1) (or (> bits 16) (> channels 2))))
         (fmt (make-bytevector (cond (ext 40) ((= format 3) 18) (else 16)) 0))
         (fact (make-bytevector 4 0)) (h (make-bytevector 12 0))
         (d (make-bytevector 8 0)))
    (ensure (<= (+ size 128) #xffffffff) 'budget "RF64 output is unsupported")
    (put-u16le! fmt 0 (if ext #xfffe format))
    (put-u16le! fmt 2 channels) (put-u32le! fmt 4 rate)
    (put-u32le! fmt 8 (* rate align)) (put-u16le! fmt 12 align) (put-u16le! fmt 14 bits)
    (when ext
      (put-u16le! fmt 16 22) (put-u16le! fmt 18 bits)
      ;; A zero speaker mask preserves channel order without inventing positions.
      (bytevector-copy! #vu8(1 0 0 0 0 0 16 0 128 0 0 170 0 56 155 113) 0 fmt 24 16))
    (put-u32le! fact 0 frames)
    (fourcc! h 0 "RIFF") (fourcc! h 8 "WAVE")
    (fourcc! d 0 "data") (put-u32le! d 4 size)
    (let* ((format-chunks (if (= format 3)
                              (bytes-append (chunk "fmt " fmt) (chunk "fact" fact))
                              (chunk "fmt " fmt)))
           (header (bytes-append h format-chunks d)))
      (put-u32le! header 4 (+ (- (bytevector-length header) 8) size (modulo size 2)))
      header)))

(define* (encode-pcm a #:key (bits 16) (format 1) (dither #f) (start-frame 0))
  (check-format (audio-rate a) (audio-channels a) (audio-frames a) bits format)
  (ensure (or (not dither) (exact-integer-in? dither 0 #xffffffff))
          'random "dither seed must be a 32-bit integer")
  (let* ((width (quotient bits 8)) (channels (audio-channels a))
         (size (* width channels (audio-frames a)))
         (scale (expt 2 (- bits 1))) (out (make-bytevector size 0)))
    (do ((i 0 (+ i 1))) ((= i (audio-frames a)))
      (do ((c 0 (+ c 1))) ((= c channels))
        (let* ((sample (audio-ref a c i))
               (at (* width (+ c (* channels i)))))
          (ensure (finite-real? sample) 'sample "cannot encode a nonfinite sample" i c)
          (let ((x (max -1.0 (min 1.0 sample))))
            (if (= format 3)
                (if (= bits 32)
                    (bytevector-ieee-single-set! out at x (endianness little))
                    (bytevector-ieee-double-set! out at x (endianness little)))
                (let* ((noise (if dither (tpdf-at dither c (+ start-frame i)) 0.0))
                       (q (inexact->exact (round (+ (* scale x) noise))))
                       (q (max (- scale) (min (- scale 1) q))))
                  (if (= bits 8)
                      (bytevector-u8-set! out at (+ q 128))
                      (do ((j 0 (+ j 1))) ((= j width))
                        (bytevector-u8-set! out (+ at j)
                                            (logand (ash q (* -8 j)) 255)))))))))) out))

(define* (encode-wave a #:key (bits 16) (format 1) (dither #f))
  (let ((pcm (encode-pcm a #:bits bits #:format format #:dither dither)))
    (bytes-append (wave-header (audio-rate a) (audio-channels a) (audio-frames a) bits format)
                  pcm (make-bytevector (modulo (bytevector-length pcm) 2) 0))))
(define* (write-wave path a #:key (bits 16) (format 1) (dither #f))
  (write-file-bytes path (encode-wave a #:bits bits #:format format #:dither dither)))
