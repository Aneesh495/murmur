;;; Shared schema operations reject unknown, duplicate, and misspelled fields.
;;; A typo in a redaction is an error, never an ignored setting.
(define-module (murmur schema)
  #:use-module (murmur error)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-13)
  #:export (fields field-value field-values field-required field-number
            field-time identifier? label? path-value? enum-value))

(define* (fields items allowed #:optional (repeat '()))
  (ensure (list? items) 'schema "expected a field list")
  (let loop ((rest items) (seen '()) (out '()))
    (if (null? rest) (reverse out)
        (let ((item (car rest)))
          (ensure (and (list? item) (pair? item) (symbol? (car item)))
                  'schema "expected a named field" item)
          (let ((key (car item)))
            (ensure (memq key allowed) 'schema "unknown field" key)
            (ensure (or (not (memq key seen)) (memq key repeat))
                    'schema "duplicate field" key)
            (loop (cdr rest) (cons key seen) (cons item out)))))))
(define (field-values fs key) (map cdr (filter (lambda (f) (eq? (car f) key)) fs)))
(define* (field-value fs key #:optional (default #f))
  (let ((f (assq key fs)))
    (if f
        (begin (ensure (= 2 (length f)) 'schema "field needs one value" key) (cadr f))
        default)))
(define (field-required fs key)
  (ensure (assq key fs) 'schema "missing field" key) (field-value fs key))
(define* (field-number fs key low high #:optional (default #f))
  (let ((v (field-value fs key default)))
    (ensure (and (finite-real? v) (<= low v high)) 'schema "number outside allowed range" key low high)
    v))
(define* (field-time fs key #:optional (default #f))
  ((module-ref (resolve-interface '(murmur clock)) 'parse-time) (field-value fs key default)))
(define (identifier? v)
  (and (symbol? v) (<= 1 (string-length (symbol->string v)) 64)))
(define (label? v)
  (and (string? v) (<= (string-length v) 200)
       (string-every (lambda (c) (>= (char->integer c) 32)) v)))
(define (path-value? v)
  (and (string? v) (<= 1 (string-length v) 4096)
       (string-every (lambda (c) (>= (char->integer c) 32)) v)))
(define (enum-value v choices)
  (ensure (memq v choices) 'schema "unsupported setting" v choices) v)
