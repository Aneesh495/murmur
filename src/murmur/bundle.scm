;;; A bundle contains only publication artifacts. The manifest is data-only and
;;; checks flat, regular files. Integrity checks do not establish authenticity.
(define-module (murmur bundle)
  #:use-module (murmur error)
  #:use-module (murmur hash)
  #:use-module (murmur data)
  #:use-module (murmur schema)
  #:use-module (murmur json)
  #:use-module (murmur provenance)
  #:use-module (murmur project model)
  #:use-module (murmur project compile)
  #:use-module (murmur wave scan)
  #:use-module (ice-9 ftw)
  #:use-module (srfi srfi-1)
  #:export (write-text write-bundle-metadata verify-bundle))
(define (write-text path text)
  (call-with-output-file path
    (lambda (p) (display text p) (force-output p) (fsync (fileno p))) #:encoding "UTF-8"))
(define mandatory '("audio.wav" "plan.json" "analysis.json" "receipt.json"))
(define allowed (append mandatory '("review.html")))
(define (write-bundle-metadata stage plan analysis)
  (write-text (string-append stage "/plan.json") (json->text (plan->json plan)))
  (write-text (string-append stage "/analysis.json") (json->text analysis))
  (let* ((names (append '("audio.wav" "plan.json" "analysis.json")
                        (if (file-exists? (string-append stage "/review.html")) '("review.html") '())))
         (files (map (lambda (name) (cons name (sha256-file (string-append stage "/" name)))) names))
         (receipt (object (cons 'schema "murmur-receipt-v1") (cons 'engine "murmur/0.1.0")
                          (cons 'planSha256 (plan-digest plan))
                          (cons 'sources (source-identities plan))
                          (cons 'files (map (lambda (f) (object (cons 'name (car f)) (cons 'sha256 (cdr f)))) files))
                          (cons 'scope "sanitized-source identity and artifact integrity; no signature"))))
    (write-text (string-append stage "/receipt.json") (json->text receipt))
    (let ((files (append files (list (cons "receipt.json" (sha256-file (string-append stage "/receipt.json"))))))
          (project (plan-project plan)))
      (write-text (string-append stage "/manifest.mur")
        (data->text `(murmur-bundle (version 1) (rate ,(project-rate project))
                                   (channels ,(project-channels project)) (frames ,(plan-frames plan))
                                   ,@(map (lambda (f) `(file ,(car f) ,(cdr f))) files)))))))
(define (verify-bundle directory)
  (let* ((root (canonicalize-path directory))
         (manifest-path (string-append root "/manifest.mur"))
         (_ (ensure (eq? (stat:type (lstat manifest-path)) 'regular)
                    'bundle "manifest is not a regular file"))
         (form (read-data-file manifest-path)))
    (ensure (and (list? form) (pair? form) (eq? (car form) 'murmur-bundle)) 'bundle "invalid bundle manifest")
    (let* ((f (fields (cdr form) '(version rate channels frames file) '(file)))
           (entries (field-values f 'file))
           (_ (ensure (every (lambda (entry)
                               (and (list? entry) (= 2 (length entry))
                                    (string? (car entry)) (string? (cadr entry)))) entries)
                      'bundle "invalid manifest file entry"))
           (names (map car entries)))
      (ensure (eqv? (field-required f 'version) 1) 'bundle "unsupported bundle version")
      (ensure (and (<= 4 (length entries) 5) (= (length names) (length (delete-duplicates names)))
                   (every (lambda (n) (member n names)) mandatory)) 'bundle "missing or duplicate bundle files")
      (for-each
       (lambda (entry)
         (ensure (and (= 2 (length entry)) (member (car entry) allowed)
                      (string? (cadr entry)) (= 64 (string-length (cadr entry)))) 'bundle "invalid manifest file entry")
         (let ((path (string-append root "/" (car entry))))
           (ensure (eq? (stat:type (lstat path)) 'regular) 'bundle "bundle file is not regular" (car entry))
           (ensure (string=? (cadr entry) (sha256-file path)) 'checksum "bundle checksum mismatch" (car entry)))) entries)
      (let ((actual (scandir root (lambda (n) (not (member n '("." "..")))))))
        (ensure (equal? (sort actual string<?) (sort (cons "manifest.mur" names) string<?))
                'bundle "bundle contains unlisted files"))
      (let ((wave (scan-wave (string-append root "/audio.wav"))))
        (ensure (and (eqv? (wave-rate wave) (field-required f 'rate))
                     (eqv? (wave-channels wave) (field-required f 'channels))
                     (eqv? (wave-frames wave) (field-required f 'frames)))
                'bundle "audio dimensions differ from manifest")
        (object (cons 'status "verified") (cons 'files (length entries))
                (cons 'frames (wave-frames wave))
                (cons 'manifestSha256 (sha256-file (string-append root "/manifest.mur"))))))))
