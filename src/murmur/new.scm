(define-module (murmur new)
  #:use-module (murmur error)
  #:use-module (murmur paths)
  #:use-module (murmur hash)
  #:use-module (murmur clock)
  #:use-module (murmur wave scan)
  #:use-module (murmur project compile)
  #:use-module (murmur patch)
  #:export (init-project))
(define (init-project input output)
  (let* ((source (canonicalize-path input)) (info (scan-wave source))
         (frames (wave-frames info)) (native (wave-rate info))
         (rate (if (< native 8000) 48000 native))
         (path (if (string=? (dirname source) (canonicalize-path (dirname output))) (basename source) source)))
    (ensure (and (> frames 0) (<= frames (* 86400 native))) 'source "recording must be positive and at most one day")
    (ensure (<= (wave-channels info) 2) 'channels "timeline sources must be mono or stereo")
    (ensure (<= (duration-frames frames native rate) (max-render-frames)) 'budget "recording exceeds render frame budget")
    (write-new-project output
      `(murmur (version 1) (rate ,rate) (channels ,(wave-channels info)) (seed 7)
               (source recording (path ,path) (sha256 ,(sha256-file source)))
               (clip take (source recording) (from 0) (to ,(/ frames native))
                     (fade-in ,(min 1/1000 (/ frames (* 4 native))))
                     (fade-out ,(min 1/1000 (/ frames (* 4 native)))))
               (effect highpass (hz 60)) (effect limit (ceiling-db -1))
               (marker (at 0) (label "Start"))))
    output))
