;;; Counter-derived noise gives the same sample regardless of block boundaries.
;;; This is an audio noise generator, not a cryptographic random source.
(define-module (murmur random)
  #:use-module (murmur error)
  #:export (mix32 uniform-at tpdf-at white-at))
(define (u32 x) (logand x #xffffffff))
(define (mix32 x)
  (let* ((x (u32 x))
         (x (u32 (* (logxor x (ash x -16)) #x7feb352d)))
         (x (u32 (* (logxor x (ash x -15)) #x846ca68b))))
    (u32 (logxor x (ash x -16)))))
(define (uniform-at seed channel frame lane)
  (ensure (and (exact-integer-in? seed 0 #xffffffff)
               (exact-integer-in? channel 0 7)
               (exact-integer? frame) (>= frame 0)
               (exact-integer-in? lane 0 255)) 'random "invalid noise coordinate")
  (/ (mix32 (logxor seed (mix32 (+ frame #x9e3779b9))
                    (mix32 (+ (* channel 257) lane #x85ebca6b))))
     4294967296.0))
(define (tpdf-at seed channel frame)
  (- (uniform-at seed channel frame 0) (uniform-at seed channel frame 1)))
(define (white-at seed channel frame)
  (- (* 2 (uniform-at seed channel frame 2)) 1.0))
