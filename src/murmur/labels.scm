;;; Audacity-style label intervals can become source-bound patches. Label text
;;; is deliberately discarded: a transcript must not hitchhike into an export.
(define-module (murmur labels)
  #:use-module (murmur error)
  #:use-module (murmur clock)
  #:use-module (murmur data)
  #:use-module (murmur binary)
  #:use-module (murmur schema)
  #:use-module (murmur provenance)
  #:use-module (murmur project parse)
  #:use-module (murmur project compile)
  #:use-module (rnrs bytevectors)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-13)
  #:export (parse-labels labels->patch))
(define (parse-labels text source mode)
  (ensure (edit-id? source) 'labels "invalid source identifier")
  (enum-value mode '(mute tone noise))
  (let ((lines (string-split text #\newline)))
    (ensure (<= (length lines) 4096) 'budget "too many label lines")
    (filter-map
     (lambda (line)
       (let ((line (string-trim-both line)))
         (if (or (string-null? line) (string-prefix? "#" line)) #f
             (let ((parts (string-split line #\tab)))
               (ensure (>= (length parts) 2) 'labels "label needs tab-separated start and end")
               (let ((from (parse-time (car parts))) (to (parse-time (cadr parts))))
                 (ensure (< from to) 'labels "redaction labels must be intervals, not point markers")
                 `(redact ,source (from ,from) (to ,to) (mode ,mode))))))) lines)))
(define (labels->patch document source path mode)
  (let* ((plan (compile-project (read-project document) document))
         (_ (ensure (find (lambda (s) (eq? source (bound-id s))) (plan-sources plan)) 'labels "unknown source" source))
         (text (utf8->string (read-file-bytes path 1048576)))
         (edits (parse-labels text source mode)))
    (ensure (pair? edits) 'labels "no redaction intervals in labels")
    `(murmur-patch (version 1) (base-plan ,(plan-digest plan))
                  ,@(map (lambda (s) `(source-sanitized-sha256 ,(bound-id s) ,(bound-sanitized-digest s))) (plan-sources plan))
                  ,@edits)))
