;;; Entirely synthetic recordings: harmonic pulses, room-like noise, electrical
;;; hum, and isolated clicks. No downloaded media or recorded voices.
(define-module (murmur demo)
  #:use-module (murmur error)
  #:use-module (murmur buffer)
  #:use-module (murmur random)
  #:use-module (murmur paths)
  #:use-module (murmur data)
  #:use-module (murmur wave encode)
  #:use-module (murmur hash)
  #:use-module (murmur bundle)
  #:use-module (murmur render)
  #:export (make-demo))
(define tau 6.283185307179586)
(define (pulse t from to)
  (if (<= from t to)
      (let ((x (/ (- t from) (- to from)))) (expt (sin (* 3.141592653589793 x)) 2)) 0.0))
(define (field-sample t i)
  (let* ((envelope (+ (pulse t 0.7 2.1) (pulse t 2.5 3.8) (pulse t 5.2 7.6)))
         (pitch (+ 125 (* 8 (sin (* 3 t)))))
         (voice (* envelope (+ (* 0.12 (sin (* tau pitch t)))
                               (* 0.05 (sin (* tau 2 pitch t)))
                               (* 0.02 (sin (* tau 3 pitch t))))))
         (identifier (if (<= 2.8 t 3.35) (* 0.15 (sin (* tau (+ 800 (* 400 (- t 2.8))) t))) 0.0))
         (hum (* 0.015 (sin (* tau 60 t))))
         (noise (* 0.008 (white-at 1977 0 i)))
         (click (if (or (= i 60000) (= i 105000)) 0.7 0.0)))
    (+ voice identifier hum noise click)))
(define (make-demo destination)
  (with-staging-directory destination
    (lambda (stage)
      (let ((field (make-audio 22050 1 (* 8 22050))) (bed (make-audio 16000 2 (* 8 16000))))
        (audio-map! field (lambda (x c i) (field-sample (/ i 22050.0) i)))
        (audio-map! bed
          (lambda (x c i)
            (let ((t (/ i 16000.0)))
              (* 0.014 (+ (sin (* tau (if (= c 0) 130.8128 155.5635) t))
                           (* 0.6 (sin (* tau 196 t))))))))
        (write-wave (string-append stage "/field.wav") field)
        (write-wave (string-append stage "/bed.wav") bed))
      (let ((form `(murmur (version 1) (rate 24000) (channels 2) (seed 1977)
                  (source field (path "field.wav") (sha256 ,(sha256-file (string-append stage "/field.wav"))))
                  (source bed (path "bed.wav") (sha256 ,(sha256-file (string-append stage "/bed.wav"))))
                  (redact field (from 2.75) (to 3.4) (mode tone) (guard 0.02) (level-db -24) (hz 880))
                  (clip opening (source field) (from 0.2) (to 4.0) (at 0) (fade-in 0.03) (fade-out 0.1))
                  (clip closing (source field) (from 4.0) (to 8.0) (at 3.7) (fade-in 0.1) (fade-out 0.06))
                  (clip atmosphere (source bed) (from 0) (to 7.7) (at 0) (gain-db -9) (fade-in 0.4) (fade-out 0.6))
                  (effect highpass (hz 80)) (effect notch (hz 60) (q 10))
                  (effect declick (threshold 0.18))
                  (effect denoise (profile-from 0) (profile-to 0.25) (size 512) (strength 0.8) (floor-db -12))
                  (effect compress (threshold-db -24) (ratio 2) (makeup-db 3))
                  (effect limit (ceiling-db -2))
                  (marker (at 0) (label "Room tone"))
                  (marker (at 0.5) (label "First take"))
                  (marker (at 2.55) (label "Source redaction"))
                  (marker (at 3.7) (label "Second take")))))
        (write-text (string-append stage "/edit.mur") (data->text form)))
      (write-text (string-append stage "/labels.tsv") "2.75\t3.4\tsynthetic identifier\n")
      (render-project (string-append stage "/edit.mur") (string-append stage "/review"))
      (write-text (string-append stage "/README.txt")
        "Synthetic source audio lives beside edit.mur. Share only review/.\nOpen review/review.html to listen and inspect the source edits.\n")))
  (format #t "Open ~a/review/review.html~%" (absolute-output destination)))
