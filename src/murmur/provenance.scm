;;; Timeline provenance describes the edit/mix stage. Stateful effects can spread
;;; influence across time, so this map does not claim to invert a final sample.
(define-module (murmur provenance)
  #:use-module (murmur error)
  #:use-module (murmur json)
  #:use-module (murmur hash)
  #:use-module (murmur project model)
  #:use-module (murmur project compile)
  #:use-module (murmur wave scan)
  #:use-module (murmur redact)
  #:use-module (srfi srfi-1)
  #:export (plan->json plan-digest explain-frame source-identities))
(define (mask->json m)
  (object (cons 'start (mask-start m)) (cons 'end (mask-end m))
          (cons 'mode (mask-mode m)) (cons 'levelDb (mask-level m)) (cons 'hz (mask-hz m))))
(define (source->json s)
  (let ((w (bound-info s)))
    (object (cons 'id (bound-id s)) (cons 'rate (wave-rate w))
            (cons 'channels (wave-channels w)) (cons 'frames (wave-frames w))
            (cons 'redactions (map mask->json (vector->list (bound-masks s)))))))
(define (clip-redactions c rate)
  (let* ((s (compiled-source c)) (native (wave-rate (bound-info s)))
         (start (compiled-start c)) (end (compiled-end c)))
    (filter-map
     (lambda (m)
       (let ((lo (max start (mask-start m))) (hi (min end (mask-end m))))
         (and (< lo hi)
              (object (cons 'start (+ (compiled-at c) (floor (/ (* (- lo start) rate) native))))
                      (cons 'end (+ (compiled-at c) (ceiling (/ (* (- hi start) rate) native))))
                      (cons 'mode (mask-mode m)))))) (vector->list (bound-masks s)))))
(define (plan->json plan)
  (let* ((p (plan-project plan)) (rate (project-rate p)))
    (object (cons 'version 1) (cons 'rate rate) (cons 'channels (project-channels p))
            (cons 'frames (plan-frames plan)) (cons 'seed (project-seed p))
            (cons 'sources (map source->json (plan-sources plan)))
            (cons 'clips
              (map (lambda (c)
                     (let ((e (compiled-edit c)))
                       (object (cons 'id (clip-id e)) (cons 'source (clip-source e))
                               (cons 'sourceStart (compiled-start c)) (cons 'sourceEnd (compiled-end c))
                               (cons 'at (compiled-at c)) (cons 'frames (compiled-frames c))
                               (cons 'gainDb (clip-gain e)) (cons 'pan (clip-pan e))
                               (cons 'fadeIn (compiled-fade-in c)) (cons 'fadeOut (compiled-fade-out c))
                               (cons 'redactions (clip-redactions c rate))))) (plan-clips plan)))
            (cons 'effects (map (lambda (spec) (format #f "~s" spec)) (project-effects p)))
            (cons 'markers (map (lambda (m) (object (cons 'frame (round (* rate (car m))))
                                                   (cons 'label (cdr m)))) (project-markers p))))))
(define (plan-digest plan) (sha256-text (json->text (plan->json plan))))
(define (source-identities plan)
  (map (lambda (s) (object (cons 'id (bound-id s)) (cons 'sha256 (bound-digest s)))) (plan-sources plan)))
(define (explain-frame plan frame)
  (ensure (exact-integer-in? frame 0 (- (plan-frames plan) 1)) 'bounds "frame outside rendered timeline")
  (let ((rate (project-rate (plan-project plan))))
    (object
     (cons 'frame frame) (cons 'stage "pre-effect mix")
     (cons 'contributors
       (filter-map
        (lambda (c)
          (let ((local (- frame (compiled-at c))))
            (and (<= 0 local (- (compiled-frames c) 1))
                 (let* ((s (compiled-source c)) (native (wave-rate (bound-info s)))
                        (center (+ (compiled-start c) (/ (* local native) rate)))
                        (support (if (= native rate) 0
                                     (+ 1 (ceiling (/ 16 (* 0.94 (min 1.0 (/ rate native))))))))
                        (lo (max (compiled-start c) (- (floor center) support)))
                        (hi (min (compiled-end c) (+ (floor center) support 1))))
                   (object (cons 'clip (clip-id (compiled-edit c))) (cons 'source (bound-id s))
                           (cons 'position (number->string center)) (cons 'stencil (list lo hi))
                           (cons 'redactedCenter (if (mask-at (bound-masks s) (floor center)) #t #f)))))))
        (plan-clips plan))))))
