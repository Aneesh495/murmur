(define-module (fixtures)
  #:use-module (murmur binary)
  #:use-module (rnrs bytevectors)
  #:export (with-bytes riff-chunk fixture-wave fixture-format))

(define serial 0)
(define (with-bytes b proc)
  (unless (file-exists? ".cache") (mkdir ".cache"))
  (set! serial (+ serial 1))
  (let ((path (format #f ".cache/fixture-~a-~a.wav" (getpid) serial)))
    (dynamic-wind
      (lambda () (write-file-bytes path b))
      (lambda () (proc path))
      (lambda () (when (file-exists? path) (delete-file path))))))
(define (riff-chunk id body)
  (let ((h (make-bytevector 8 0)))
    (fourcc! h 0 id) (put-u32le! h 4 (bytevector-length body))
    (bytes-append h body (make-bytevector (modulo (bytevector-length body) 2) 0))))
(define* (fixture-format #:optional (tag 1) (bits 16) (channels 1) (rate 8000))
  (let* ((b (make-bytevector (if (= tag 3) 18 16) 0))
         (align (* channels (quotient bits 8))))
    (put-u16le! b 0 tag) (put-u16le! b 2 channels) (put-u32le! b 4 rate)
    (put-u32le! b 8 (* rate align)) (put-u16le! b 12 align) (put-u16le! b 14 bits) b))
(define (fixture-wave . chunks)
  (let* ((body (apply bytes-append chunks)) (h (make-bytevector 12 0)))
    (fourcc! h 0 "RIFF") (put-u32le! h 4 (+ 4 (bytevector-length body)))
    (fourcc! h 8 "WAVE") (bytes-append h body)))
