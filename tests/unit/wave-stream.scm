(use-modules (test) (fixtures) (murmur wave stream) (murmur wave encode)
             (murmur buffer) (murmur binary) (murmur project parse) (murmur project compile))
(test "stream writer matches one-shot bytes"
  (let ((a (make-audio 8000 2 97)))
    (audio-map! a (lambda (x c i) (* 0.5 (sin (+ c i)))))
    (with-bytes #vu8()
      (lambda (path)
        (call-with-wave-writer path 8000 2 97
          (lambda (put)
            (put (audio-slice a 0 13)) (put (audio-slice a 13 97))) #:dither 42)
        (check-equal (encode-wave a #:dither 42) (read-file-bytes path))))))
(test "sanitized source pages survive cache eviction"
  (let ((a (make-audio 8000 1 20000)))
    (audio-map! a (lambda (x c i) 0.5))
    (with-bytes (encode-wave a)
      (lambda (path)
        (let* ((p (parse-project `(murmur (version 1)
                                     (source x (path ,(canonicalize-path path)))
                                     (redact x (from 1/100) (to 2/100) (guard 0))
                                     (clip a (source x) (to 2)))))
               (plan (compile-project p path)))
          (with-source-readers (plan-sources plan)
            (lambda (readers)
              (let ((r (cdar readers)))
                (check-near 0 (source-reader-ref r 0 100) 0)
                (check-near 0.5 (source-reader-ref r 0 17000) 0)
                (check-near 0 (source-reader-ref r 0 100) 0)
                (check-equal 3 (source-reader-page-loads r))))))))))
