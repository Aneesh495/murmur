(use-modules (test) (fixtures) (murmur buffer) (murmur wave encode) (murmur binary)
             (murmur project parse) (murmur project compile) (murmur fingerprint))
(test "a changed-and-restored source is not an immutable read"
  (with-bytes (encode-wave (make-audio 8000 1 80))
    (lambda (path)
      (let* ((form `(murmur (version 1) (rate 8000)
                            (source field (path ,(canonicalize-path path)))
                            (clip a (source field) (to 1/100))))
             (plan (compile-project (parse-project form) path))
             (bytes (read-file-bytes path)) (metadata (stat path))
             (fingerprint (bound-fingerprint (car (plan-sources plan)))))
        (write-file-bytes path #vu8(1 2 3))
        (write-file-bytes path bytes)
        (utime path (stat:atime metadata) (vector-ref fingerprint 3) 0 (vector-ref fingerprint 4))
        (let ((after (file-fingerprint path)))
          (check-equal (vector-ref fingerprint 3) (vector-ref after 3))
          (check-equal (vector-ref fingerprint 4) (vector-ref after 4)))
        (check-error 'source (lambda () (assert-sources-unchanged plan)))))))
