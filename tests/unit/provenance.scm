(use-modules (test) (fixtures) (murmur provenance) (murmur project parse)
             (murmur project compile) (murmur buffer) (murmur wave encode) (murmur json))
(test "edit maps use aliases rather than source paths"
  (with-bytes (encode-wave (make-audio 8000 1 800))
    (lambda (path)
      (let* ((p (parse-project `(murmur (version 1) (rate 8000)
                           (source field (path ,(canonicalize-path path)))
                           (redact field (from 1/100) (to 2/100) (guard 0))
                           (clip a (source field) (to 1/10)))))
             (plan (compile-project p path)) (text (json->text (plan->json plan))))
        (check (not (string-contains text path)))
        (check (= 64 (string-length (plan-digest plan))))
        (check (string-contains (json->text (explain-frame plan 100)) "\"redactedCenter\":true"))
        (check-error 'bounds (lambda () (explain-frame plan 800)))))))
