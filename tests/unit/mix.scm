(use-modules (test) (fixtures) (murmur mix) (murmur buffer) (murmur binary)
             (murmur wave encode) (murmur wave stream) (murmur project parse) (murmur project compile))
(test "timeline mixing is independent of block partition"
  (let ((a (make-audio 8000 1 800)))
    (audio-map! a (lambda (x c i) (* 0.4 (sin (* 0.1 i)))))
    (with-bytes (encode-wave a)
      (lambda (path)
        (let* ((p (parse-project `(murmur (version 1) (rate 11025)
                           (source x (path ,(canonicalize-path path)))
                           (redact x (from 2/100) (to 3/100) (guard 0))
                           (clip one (source x) (to 1/10) (fade-in 1/100))
                           (clip two (source x) (from 1/100) (to 1/10) (at 1/20) (gain-db -6)))))
               (plan (compile-project p path)) (whole (encode-pcm (render-mix plan))))
          (with-source-readers (plan-sources plan)
            (lambda (readers)
              (let ((mix (make-mixer plan readers)) (parts '()))
                (do ((at 0 (+ at 137))) ((>= at (plan-frames plan)))
                  (set! parts (cons (encode-pcm (mix at (min 137 (- (plan-frames plan) at)))) parts)))
                (check-equal whole (apply bytes-append (reverse parts)))))))))))
