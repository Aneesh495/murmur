(use-modules (test) (fixtures) (murmur render) (murmur paths) (murmur bundle)
             (murmur data) (murmur buffer) (murmur wave encode) (murmur binary))
(define (render-fixture effect proc)
  (let ((base (mkdtemp "/tmp/murmur-render-XXXXXX")))
    (dynamic-wind
      (lambda ()
        (let ((a (make-audio 8000 1 1600)))
          (audio-map! a (lambda (x c i) (* 0.2 (sin (* i 0.2)))))
          (write-wave (string-append base "/input.wav") a))
        (write-text (string-append base "/edit.mur")
          (data->text `(murmur (version 1) (rate 8000) (source field (path "input.wav"))
                               (redact field (from 1/20) (to 1/10) (guard 0))
                               (clip a (source field) (to 1/5)) ,@effect))))
      (lambda () (proc base))
      (lambda () (remove-private-tree base)))))
(test "whole render and verified publication"
  (render-fixture '((effect highpass (hz 80)) (effect limit))
    (lambda (base)
      (render-project (string-append base "/edit.mur") (string-append base "/out") #:block-size 137)
      (verify-bundle (string-append base "/out"))
      (check (file-exists? (string-append base "/out/audio.wav")))
      (check-error 'exists (lambda () (render-project (string-append base "/edit.mur") (string-append base "/out")))))))
(test "offline repair enters the same publication boundary"
  (render-fixture '((effect remove-dc) (effect normalize (peak-db -3)))
    (lambda (base)
      (render-project (string-append base "/edit.mur") (string-append base "/out"))
      (check (file-exists? (string-append base "/out/manifest.mur"))))))
