(use-modules (test) (fixtures) (murmur project parse) (murmur project compile)
             (murmur buffer) (murmur wave encode) (murmur binary))
(test "compile clips onto sample clocks"
  (with-bytes (encode-wave (make-audio 8000 1 800))
    (lambda (path)
      (let* ((form `(murmur (version 1) (rate 16000)
                            (source x (path ,(canonicalize-path path)))
                            (redact x (from 1/100) (to 2/100))
                            (clip a (source x) (from 1/100) (to 9/100) (at 1/10))))
             (plan (compile-project (parse-project form) path)) (c (car (plan-clips plan))))
        (check-equal 80 (compiled-start c))
        (check-equal 1280 (compiled-frames c))
        (check-equal 2880 (plan-frames plan))
        (assert-sources-unchanged plan)
        (write-file-bytes path #vu8(0))
        (check-error 'source (lambda () (assert-sources-unchanged plan)))))))
