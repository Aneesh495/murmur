(use-modules (test) (fixtures) (murmur bundle) (murmur paths) (murmur buffer)
             (murmur wave encode) (murmur project parse) (murmur project compile) (murmur json))
(test "bundle integrity and extra-file rejection"
  (with-bytes (encode-wave (make-audio 8000 1 80))
    (lambda (path)
      (let* ((p (parse-project `(murmur (version 1) (rate 8000) (channels 1)
                           (source x (path ,(canonicalize-path path))) (clip a (source x) (to 1/100)))))
             (plan (compile-project p path)) (stage (mkdtemp "/tmp/murmur-bundle-XXXXXX")))
        (dynamic-wind
          (lambda () #t)
          (lambda ()
            (write-wave (string-append stage "/audio.wav") (make-audio 8000 1 80))
            (write-bundle-metadata stage plan (object))
            (check (string-contains (json->text (verify-bundle stage)) "verified"))
            (write-text (string-append stage "/extra.txt") "extra")
            (check-error 'bundle (lambda () (verify-bundle stage)))
            (delete-file (string-append stage "/extra.txt"))
            (write-text (string-append stage "/analysis.json") "changed")
            (check-error 'checksum (lambda () (verify-bundle stage))))
          (lambda () (remove-private-tree stage)))))))
