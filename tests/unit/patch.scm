(use-modules (test) (murmur patch) (murmur paths) (murmur bundle) (murmur buffer)
             (murmur data) (murmur wave encode) (murmur project compile)
             (murmur project parse) (murmur project model) (murmur provenance))
(test "source patches are bound and non-destructive"
  (let* ((base (mkdtemp "/tmp/murmur-patch-XXXXXX"))
         (doc (string-append base "/edit.mur")) (patch (string-append base "/patch.mur"))
         (out (string-append base "/next.mur")))
    (dynamic-wind
      (lambda () #t)
      (lambda ()
        (write-wave (string-append base "/input.wav") (make-audio 8000 1 800))
        (write-new-project doc '(murmur (version 1) (rate 8000) (source x (path "input.wav"))
                                       (clip a (source x) (to 1/10))))
        (let* ((plan (compile-project (read-project doc) doc)) (s (car (plan-sources plan)))
               (form `(murmur-patch (version 1) (base-plan ,(plan-digest plan))
                                   (source-sha256 x ,(bound-digest s))
                                   (redact x (from 1/100) (to 2/100)))))
          (write-text patch (data->text form))
          (apply-source-patch doc patch out)
          (check (= 1 (length (project-redactions (read-project out)))))
          (check-error 'exists (lambda () (apply-source-patch doc patch out)))
          (write-text patch (data->text (append form '((redact x (from 0) (to 1) (mode unknown))))))
          (check-error 'schema (lambda () (apply-source-patch doc patch (string-append base "/bad.mur"))))))
      (lambda () (remove-private-tree base)))))
