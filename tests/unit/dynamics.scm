(use-modules (test) (murmur dsp dynamics) (murmur dsp envelope) (murmur buffer)
             (murmur wave encode) (murmur binary))
(test "soft-knee compression curve"
  (check-near 0 (compressor-curve -30 -18 3 6) 0)
  (check-near -12 (compressor-curve 0 -18 3 0) 1e-12)
  (check-near 0 (compressor-curve -21 -18 3 6) 1e-12)
  (check-near -2 (compressor-curve -15 -18 3 6) 1e-12))
(test "linked limiter and dynamics blocking"
  (for-each
   (lambda (constructor)
     (let ((a (make-audio 8000 2 1000)) (whole (constructor)) (split (constructor)))
       (audio-map! a (lambda (x c i) (* (+ c 1) (sin (* i 0.04)))))
       (let ((b (whole (audio-copy a))))
         (check (audio-finite? b))
         (check-equal (encode-pcm b)
           (bytes-append (encode-pcm (split (audio-slice a 0 333)))
                         (encode-pcm (split (audio-slice a 333 1000))))))))
   (list (lambda () (make-compressor 8000 2)) (lambda () (make-gate 8000 2))
         (lambda () (make-limiter 8000 2))))
  (let ((a (make-audio 8000 2 100)))
    (audio-map! a (lambda (x c i) (* (+ c 1) 4.0)))
    ((make-limiter 8000 2 #:ceiling-db -3) a)
    (check (<= (audio-peak a) (+ (db->gain -3) 1e-12)))
    (check-near 2 (/ (audio-ref a 1 10) (audio-ref a 0 10)) 1e-12)))
